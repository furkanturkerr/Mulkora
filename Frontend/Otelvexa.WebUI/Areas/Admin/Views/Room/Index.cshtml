@model List<Otelvexa.Dto.RoomDtos.ResultRoomDto>

@{
    ViewData["Title"] = "Index";
    Layout = "_AdminLayout";
    int count = 0;
}

<table class="table table-bordered">
    <tr>
        <th>#</th>
        <th>Oda Numarası</th>
        <th>Başlık</th>
        <th>Sil</th>
        <th>Güncelle</th>
    </tr>
    @foreach (var item in Model)
    {
        count++;
        <tr>
            <th>@count</th>
            <td>@item.RoomNumber</td>
            <td>@item.Title</td>
            <td><a href="~/Admin/Room/Delete/@item.RoomId" class="btn mb-1 btn-rounded btn-outline-danger">Sil</a></td>
            <td><a href="~/Admin/Room/Update/@item.RoomId" class="btn mb-1 btn-rounded btn-outline-success">Güncelle</a></td>
        </tr>
    }
</table>




<a href="~/Admin/Room/Create/" class="btn mb-1 btn-rounded btn-outline-info">Yeni Oda Girişi</a>