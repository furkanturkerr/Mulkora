@model List<Otelvexa.Dto.ServiceDtos.ResultServiceDto>

@{
    ViewData["Title"] = "Index";
    Layout = "_AdminLayout";
}

<table class="table table-bordered">
    <tr>
        <th>#</th>
        <th>Hizmet Başlığı</th>
        <th>Sil</th>
        <th>Güncelle</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <th>@item.ServiceID</th>
            <td>@item.Title</td>
            <td><a href="~/Admin/Service/Delete/@item.ServiceID" class="btn mb-1 btn-rounded btn-outline-danger">Sil</a></td>
            <td><a href="~/Admin/Service/Update/@item.ServiceID" class="btn mb-1 btn-rounded btn-outline-success">Güncelle</a></td>
        </tr>
    }
</table>
<a href="~/Admin/Service/Create/" class="btn mb-1 btn-rounded btn-outline-info">Yeni Hizmet Girişi</a>