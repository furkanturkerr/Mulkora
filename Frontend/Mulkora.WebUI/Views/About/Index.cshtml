@model dynamic

@{
    Layout = "_Layout";
}

<section class="page-hero">
        <div class="container">
            <div class="page-hero-shell">
                <div class="breadcrumbs"><a href="index.html">Ana Sayfa</a><span>/</span><span>Hakkımızda</span></div>
                <div class="page-title"><h1>Emlak deneyimini sadeleştiriyoruz.</h1>
                    <p>Mülkora, ilan keşfinden ev gösterim randevusuna kadar dağınık süreci tek platformda bir araya
                        getirir.</p></div>
            </div>
        </div>
    </section>
    <section class="section-sm">
        <div class="container">
            <div class="testimonial">
                <div class="testimonial-media"></div>
                <div class="testimonial-copy"><span class="eyebrow" style="color:#efcfaa">Misyonumuz</span>
                    <blockquote>Doğru ev, doğru bilgi ve doğru danışmanla bulunur.</blockquote>
                    <p style="color:rgba(255,255,255,.7)">Şeffaf ilan bilgileri, doğrulanmış danışman profilleri ve
                        planlı randevu akışıyla emlak arama sürecini daha güvenilir hale getiriyoruz.</p></div>
            </div>
        </div>
    </section>
    <section class="section">
        <div class="container">
            <div class="section-title">
                <div><span class="eyebrow">Değerlerimiz</span>
                    <h2>Her adımda güven ve açıklık.</h2></div>
            </div>
            <div class="steps">
                <div class="step-card"><span class="step-no">01</span>
                    <h3>Doğruluk</h3>
                    <p>İlan ve danışman bilgilerinin güncel, açık ve anlaşılır sunulmasını önemseriz.</p></div>
                <div class="step-card"><span class="step-no">02</span>
                    <h3>Kolaylık</h3>
                    <p>Karmaşık emlak süreçlerini kullanıcı için sade ve yönetilebilir hale getiririz.</p></div>
                <div class="step-card"><span class="step-no">03</span>
                    <h3>Şeffaflık</h3>
                    <p>Randevu durumu, danışman bilgileri ve ilan detayları her zaman görünürdür.</p></div>
            </div>
        </div>
    </section>