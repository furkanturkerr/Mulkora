@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<aside class="workspace-sidebar">
    <a class="workspace-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
        <img src="~/Mulkora_Full_Theme_With_Panels/assets/images/logo.svg" alt="Mülkora">
        <div>
            <strong>Mülk<span>ora</span></strong>
            <small>Yönetim Paneli</small>
        </div>
    </a>

    <div class="workspace-role">Yönetim Paneli</div>

    <nav class="workspace-nav">

        <div class="nav-group">
            <div class="nav-label">GENEL</div>

            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="@(currentController == "Dashboard" ? "active" : "")">
                <span class="nav-icon">
                    <svg class="icon" width="18" height="18" viewBox="0 0 24 24">
                        <path d="M4 4h6v6H4V4Zm10 0h6v10h-6V4ZM4 14h6v6H4v-6Zm10 4h6v2h-6v-2Z"></path>
                    </svg>
                </span>
                Genel Bakış
            </a>
        </div>

        <div class="nav-group">
            <div class="nav-label">YÖNETİM</div>

            <a asp-area="Admin" asp-controller="Property" asp-action="PropertyList"> 
                <span class="nav-icon">
                    <svg class="icon" width="18" height="18" viewBox="0 0 24 24">
                        <path d="M5 21V4h10v17M15 9h4v12M8 8h2M8 12h2M8 16h2M12 8h1M12 12h1M12 16h1M3 21h18"></path>
                    </svg>
                </span>
                İlanlar
                <span class="nav-count">14</span>
            </a>

            <a href="property-review.html">
                <span class="nav-icon">
                    <svg class="icon" width="16" height="16" viewBox="0 0 24 24">
                        <path d="m5 12 4 4L19 6"></path>
                    </svg>
                </span>
                İlan Onayları
                <span class="nav-count">6</span>
            </a>

            <a href="appointments.html">
                <span class="nav-icon">
                    <svg class="icon" width="18" height="18" viewBox="0 0 24 24">
                        <path d="M5 4h14a2 2 0 0 1 2 2v14H3V6a2 2 0 0 1 2-2Zm2-2v4m10-4v4M3 9h18"></path>
                    </svg>
                </span>
                Randevular
                <span class="nav-count">9</span>
            </a>

            <a asp-area="Admin" asp-controller="Agent" asp-action="AgentList" class="@(currentController == "Agent" ? "active" : "")">
                <span class="nav-icon">
                    <svg class="icon" width="18" height="18" viewBox="0 0 24 24">
                        <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 9a7 7 0 0 1 14 0M17 8h4m-2-2v4"></path>
                    </svg>
                </span>
                Danışmanlar
            </a>

            <a asp-area="Admin" asp-controller="User" asp-action="UserList" class="@(currentController == "User" ? "active" : "")">
                <span class="nav-icon">
                    <svg class="icon" width="18" height="18" viewBox="0 0 24 24">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2M9.5 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm6.5 4a4 4 0 0 1 5 4v2m-3-10a4 4 0 0 0 0-8"></path>
                    </svg>
                </span>
                Kullanıcılar
            </a>
            
            <a asp-area="Admin" asp-controller="Role" asp-action="RoleList"
               class="sidebar-link @(currentController == "Role" ? "active" : "")">
                <svg class="icon" width="18" height="18" viewBox="0 0 24 24">
                    <path d="M12 3 4 7v5c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V7l-8-4Z"/>
                    <path d="M9 12l2 2 4-4"/>
                </svg>
                <span>Rol Yönetimi</span>
            </a>
            
            <a asp-area="Admin" asp-controller="Category" asp-action="Index">
                <span class="nav-icon">
                    <svg class="icon" width="18" height="18" viewBox="0 0 24 24">
                        <path d="M4 4h6v6H4V4Zm10 0h6v6h-6V4ZM4 14h6v6H4v-6Zm10 0h6v6h-6v-6Z"></path>
                    </svg>
                </span>
                Kategoriler
            </a>
            
            <a asp-area="Admin" asp-controller="Feature" asp-action="Index">
                <span class="nav-icon">
                    <svg class="icon" width="18" height="18" viewBox="0 0 24 24">
                        <path d="M4 4h6v6H4V4Zm10 0h6v6h-6V4ZM4 14h6v6H4v-6Zm10 0h6v6h-6v-6Z"></path>
                    </svg>
                </span>
                Özellikler
            </a>
        </div>

        <div class="nav-group">
            <div class="nav-label">İLETİŞİM</div>

            <a asp-area="Admin" asp-controller="Contact" asp-action="MessageList" class="@(currentController == "Contact" && currentAction == "MessageList" ? "active" : "")">
                <span class="nav-icon">
                    <svg class="icon" width="18" height="18" viewBox="0 0 24 24">
                        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                        <path d="m3 7 9 6 9-6"></path>
                    </svg>
                </span>
                İletişim Mesajları
            </a>

            <a asp-area="Admin" asp-controller="Message" asp-action="Index" class="@(currentController == "Message" ? "active" : "")">
                <span class="nav-icon">
                    <svg class="icon" width="18" height="18" viewBox="0 0 24 24">
                        <path d="M4 5h16v12H8l-4 4V5Z"></path>
                        <path d="M8 9h8M8 13h5"></path>
                    </svg>
                </span>
                Mesajlar
            </a>
        </div>

        <div class="nav-group">
            <div class="nav-label">SİSTEM</div>

            <a href="settings.html">
                <span class="nav-icon">
                    <svg class="icon" width="18" height="18" viewBox="0 0 24 24">
                        <path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm0-12v2m0 13v2m8.5-8.5h-2m-13 0h-2m14-6.5-1.4 1.4m-8.2 8.2-1.4 1.4m11 0-1.4-1.4M7.9 6.9 6.5 5.5"></path>
                    </svg>
                </span>
                Ayarlar
            </a>

            <a asp-area="" asp-controller="Default" asp-action="Index">
                <span class="nav-icon">
                    <svg class="icon" width="18" height="18" viewBox="0 0 24 24">
                        <path d="m3 11 9-7 9 7M5 10v10h14V10M9 20v-6h6v6"></path>
                    </svg>
                </span>
                Siteye Dön
            </a>
        </div>

    </nav>

    <div class="sidebar-profile">
        <img src="~/Mulkora_Full_Theme_With_Panels/assets/images/agents/agent-04.svg" alt="Furkan Türker">

        <div>
            <strong>Furkan Türker</strong>
            <span>Sistem Yöneticisi</span>
        </div>

        <button type="button" aria-label="Çıkış">
            <svg class="icon" width="18" height="18" viewBox="0 0 24 24">
                <path d="M10 17l5-5-5-5m5 5H3m14-8h4v16h-4"></path>
            </svg>
        </button>
    </div>
</aside>