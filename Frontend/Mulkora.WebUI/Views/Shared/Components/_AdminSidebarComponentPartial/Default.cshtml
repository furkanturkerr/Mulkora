@using System.Security.Claims
@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString();
}

<aside class="workspace-sidebar">

    <a class="workspace-brand"
       asp-area="Admin"
       asp-controller="Dashboard"
       asp-action="Index">

        <img src="~/Mulkora_Full_Theme_With_Panels/assets/images/logo.svg"
             alt="Mülkora">

        <div>
            <strong>Mülk<span>ora</span></strong>
            <small>YÖNETİM PANELİ</small>
        </div>
    </a>

    <div class="workspace-role">
        <span class="workspace-role-dot"></span>
        <span>Yönetim Paneli</span>
    </div>

    <nav class="workspace-nav">

        <div class="nav-group">
            <div class="nav-label">GENEL</div>

            <a asp-area="Admin"
               asp-controller="Dashboard"
               asp-action="Index"
               class="@(currentController == "Dashboard" ? "active" : "")">

                <span class="nav-icon">
                    <svg class="icon"
                         width="18"
                         height="18"
                         viewBox="0 0 24 24">
                        <path d="M4 4h6v6H4V4Zm10 0h6v10h-6V4ZM4 14h6v6H4v-6Zm10 4h6v2h-6v-2Z"></path>
                    </svg>
                </span>

                Genel Bakış
            </a>

            <a asp-area=""
               asp-controller="Default"
               asp-action="Index">

                <span class="nav-icon">
                    <svg class="icon"
                         width="18"
                         height="18"
                         viewBox="0 0 24 24">
                        <path d="m3 11 9-7 9 7"></path>
                        <path d="M5 10v10h14V10"></path>
                        <path d="M9 20v-6h6v6"></path>
                    </svg>
                </span>

                Siteye Git
            </a>
            
            <a href="appointments.html">

                <span class="nav-icon">
                    <svg class="icon"
                         width="18"
                         height="18"
                         viewBox="0 0 24 24">
                        <path d="M5 4h14a2 2 0 0 1 2 2v14H3V6a2 2 0 0 1 2-2Z"></path>
                        <path d="M7 2v4M17 2v4M3 9h18"></path>
                    </svg>
                </span>

                Randevular

                <span class="nav-count">9</span>
            </a>
        </div>

        <div class="nav-group">
            <div class="nav-label">YÖNETİM</div>

            <a asp-area="Admin"
               asp-controller="Property"
               asp-action="PropertyList"
               class="@(currentController == "Property" &&
                      currentAction != "PropertyReview"
                          ? "active"
                          : "")">

                <span class="nav-icon">
                    <svg class="icon"
                         width="18"
                         height="18"
                         viewBox="0 0 24 24">
                        <path d="M5 21V4h10v17"></path>
                        <path d="M15 9h4v12"></path>
                        <path d="M8 8h2M8 12h2M8 16h2"></path>
                        <path d="M12 8h1M12 12h1M12 16h1"></path>
                        <path d="M3 21h18"></path>
                    </svg>
                </span>

                İlanlar

                <span class="nav-count">14</span>
            </a>
            
            <a asp-area="Admin"
               asp-controller="Category"
               asp-action="Index"
               class="@(currentController == "Category" ? "active" : "")">

                <span class="nav-icon">
                    <svg class="icon"
                         width="18"
                         height="18"
                         viewBox="0 0 24 24">
                        <path d="M4 4h6v6H4V4Z"></path>
                        <path d="M14 4h6v6h-6V4Z"></path>
                        <path d="M4 14h6v6H4v-6Z"></path>
                        <path d="M14 14h6v6h-6v-6Z"></path>
                    </svg>
                </span>

                Kategoriler
            </a>

            <a asp-area="Admin"
               asp-controller="Feature"
               asp-action="Index"
               class="@(currentController == "Feature" ? "active" : "")">

                <span class="nav-icon">
                    <svg class="icon"
                         width="18"
                         height="18"
                         viewBox="0 0 24 24">
                        <path d="M12 3 14.8 8.7 21 9.6l-4.5 4.4 1.1 6.2L12 17.3l-5.6 2.9 1.1-6.2L3 9.6l6.2-.9L12 3Z"></path>
                    </svg>
                </span>

                Özellikler
            </a>

            

            <a asp-area="Admin"
               asp-controller="Agent"
               asp-action="AgentList"
               class="@(currentController == "Agent" ? "active" : "")">

                <span class="nav-icon">
                    <svg class="icon"
                         width="18"
                         height="18"
                         viewBox="0 0 24 24">
                        <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"></path>
                        <path d="M5 21a7 7 0 0 1 14 0"></path>
                        <path d="M17 8h4M19 6v4"></path>
                    </svg>
                </span>

                Danışmanlar
            </a>

            <a asp-area="Admin"
               asp-controller="User"
               asp-action="UserList"
               class="@(currentController == "User" ? "active" : "")">

                <span class="nav-icon">
                    <svg class="icon"
                         width="18"
                         height="18"
                         viewBox="0 0 24 24">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"></path>
                        <path d="M9.5 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"></path>
                        <path d="M16 15a4 4 0 0 1 5 4v2"></path>
                        <path d="M18 11a4 4 0 0 0 0-8"></path>
                    </svg>
                </span>

                Kullanıcılar
            </a>

            <a asp-area="Admin"
               asp-controller="Role"
               asp-action="RoleList"
               class="@(currentController == "Role" ? "active" : "")">

                <span class="nav-icon">
                    <svg class="icon"
                         width="18"
                         height="18"
                         viewBox="0 0 24 24">
                        <path d="M12 3 4 7v5c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V7l-8-4Z"></path>
                        <path d="m9 12 2 2 4-4"></path>
                    </svg>
                </span>

                Rol Yönetimi
            </a>
        </div>

        <div class="nav-group">
            <div class="nav-label">İLETİŞİM</div>

            <a asp-area="Admin"
               asp-controller="Contact"
               asp-action="MessageList"
               class="@(currentController == "Contact" &&
                         currentAction == "MessageList"
                             ? "active"
                             : "")">

                <span class="nav-icon">
                    <svg class="icon"
                         width="18"
                         height="18"
                         viewBox="0 0 24 24">
                        <rect x="3"
                              y="5"
                              width="18"
                              height="14"
                              rx="2">
                        </rect>

                        <path d="m3 7 9 6 9-6"></path>
                    </svg>
                </span>

                İletişim Mesajları
            </a>

            <a asp-area="Admin"
               asp-controller="Message"
               asp-action="Index"
               class="@(currentController == "Message" ? "active" : "")">

                <span class="nav-icon">
                    <svg class="icon"
                         width="18"
                         height="18"
                         viewBox="0 0 24 24">
                        <path d="M4 5h16v12H8l-4 4V5Z"></path>
                        <path d="M8 9h8M8 13h5"></path>
                    </svg>
                </span>

                Mesajlar
            </a>
        </div>

    </nav>

    <div class="sidebar-profile">

        <img src="~/Mulkora_Full_Theme_With_Panels/assets/images/agents/agent-04.svg"
             alt="Furkan Türker">

        <div>
            <strong>@User.FindFirst(ClaimTypes.Name)?.Value @User.FindFirst(ClaimTypes.Surname)?.Value</strong>
        </div>

        <button type="button"
                aria-label="Çıkış">

            <svg class="icon"
                 width="18"
                 height="18"
                 viewBox="0 0 24 24">
                <path d="M10 17l5-5-5-5"></path>
                <path d="M15 12H3"></path>
                <path d="M17 4h4v16h-4"></path>
            </svg>
        </button>

    </div>

</aside>