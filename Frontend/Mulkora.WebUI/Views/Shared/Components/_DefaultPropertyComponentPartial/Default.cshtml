                                                                                                                                                                                                                                       d="M4 18 18 4l2 2L6 20l-2-2Zm8-8 2 2m-5 1 2 2"/></svg> 165 m²</span><span
                                                                                                                                                                                                                                                                                                               class="spec"><svg class="icon" width="16" height="16" viewBox="0 0 24 24"
                                                                                                                                                                                                                                                                                                                                 aria-hidden="true"><path
                                                                                                                                                                                                                                                                                                                                                        d="M4 12h16v3a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4v-3Zm3 0V7a3 3 0 0 1 6 0"/></svg> 2 Banyo</span>
