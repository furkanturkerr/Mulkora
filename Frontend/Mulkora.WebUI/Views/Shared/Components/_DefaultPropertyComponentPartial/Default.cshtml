@model dynamic

<section class="section">
    <div class="container">
        <div class="section-title reveal">
            <div><span class="eyebrow">Yeni eklenenler</span>
                <h2>Hayatınıza uyan seçkin ilanlar.</h2>
                <p>Konumu, mimarisi ve yaşam kalitesiyle öne çıkan güncel portföyler.</p></div>
            <a class="text-link" href="properties.html">Tüm ilanlar
                <svg class="icon" width="17" height="17" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 12h14M14 7l5 5-5 5"/>
                </svg>
            </a></div>
        <div class="property-grid">
            <article class="property-card " data-property-card>
                <a href="property-detail.html" aria-label="Modern Bahçe Villası">
                    <div class="property-media"><img src="assets/images/properties/property-01.svg"
                                                     alt="Modern Bahçe Villası">
                        <div class="property-tags"><span class="badge accent">Yeni</span><span
                                                                                             class="badge">Satılık</span></div>
                    </div>
                    <div class="property-body">
                        <div class="property-price">₺18.750.000</div>
                        <h3>Modern Bahçe Villası</h3>
                        <div class="location">
                            <svg class="icon" width="15" height="15" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0ZM12 12a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/>
                            </svg>
                            Zekeriyaköy, İstanbul
                        </div>
                        <p class="card-description">Doğayla iç içe, yüksek tavanlı ve özel bahçeli modern yaşam
                            alanı.</p>
                        <div class="specs"><span class="spec"><svg class="icon" width="16" height="16"
                                                                   viewBox="0 0 24 24" aria-hidden="true"><path
                                                                                                              d="M3 19v-6h18v6M5 13V7h6a3 3 0 0 1 3 3v3M5 19v2M19 19v2"/></svg> 5+1</span><span
                                                                                                                                                                                              class="spec"><svg class="icon" width="16" height="16" viewBox="0 0 24 24"
                                                                                                                                                                                                                aria-hidden="true"><path
                                                                                                                                                                                                                                       d="M4 18 18 4l2 2L6 20l-2-2Zm8-8 2 2m-5 1 2 2"/></svg> 320 m²</span><span
                                                                                                                                                                                                                                                                                                               class="spec"><svg class="icon" width="16" height="16" viewBox="0 0 24 24"
                                                                                                                                                                                                                                                                                                                                 aria-hidden="true"><path
                                                                                                                                                                                                                                                                                                                                                        d="M4 12h16v3a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4v-3Zm3 0V7a3 3 0 0 1 6 0"/></svg> 3 Banyo</span>
                        </div>
                    </div>
                </a>
                <button class="favorite" type="button" data-id="01" aria-label="Favorilere ekle"
                        aria-pressed="false">
                    <svg class="icon" width="19" height="19" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21.2l8.8-8.8a5.5 5.5 0 0 0 0-7.8Z"/>
