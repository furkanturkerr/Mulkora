@model List<Mulkora.Dto.PropertyDtos.ResultPropertyDto>

@{
    var fallbackImage = Url.Content(
        "~/Mulkora_Full_Theme_With_Panels/assets/images/properties/property-01.svg"
    );
}

<section class="section">
    <div class="container">

        <div class="section-title reveal">

            <div>
                <span class="eyebrow">
                    Yeni eklenenler
                </span>

                <h2>
                    Hayatınıza uyan seçkin ilanlar.
                </h2>

                <p>
                    Konumu, mimarisi ve yaşam kalitesiyle öne
                    çıkan güncel portföyler.
                </p>
            </div>

            <a asp-controller="Property"
               asp-action="Index"
               class="text-link">

                Tüm ilanlar

                <svg class="icon"
                     width="17"
                     height="17"
                     viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M5 12h14M14 7l5 5-5 5"></path>
                </svg>
            </a>

        </div>

        @if (Model != null && Model.Count > 0)
        {
            <div class="property-grid">

                @foreach (var item in Model)
                {
                    var listingTypeValue =
                        Convert.ToInt32(item.ListingType);

                    var listingTypeText =
                        listingTypeValue == 1
                            ? "Satılık"
                            : "Kiralık";

                    var priceSuffix =
                        listingTypeValue == 2
                            ? " / ay"
                            : string.Empty;

                    var isNew =
                        item.CreatedDate >= DateTime.UtcNow.AddDays(-7);

                    var imageUrl = fallbackImage;

                    if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        imageUrl = item.ImageUrl.StartsWith(
                            "http",
                            StringComparison.OrdinalIgnoreCase
                        )
                            ? item.ImageUrl
                            : $"http://localhost:5214/{item.ImageUrl.TrimStart('/')}";
                    }

                    var description =
                        string.IsNullOrWhiteSpace(item.Description)
                            ? "Bu ilan için henüz açıklama girilmemiş."
                            : item.Description;

                    if (description.Length > 115)
                    {
                        description =
                            description.Substring(0, 115).Trim() + "...";
                    }

                    <article class="property-card"
                             data-property-card>

                        <a asp-controller="Property"
                           asp-action="Details"
                           asp-route-id="@item.PropertyId"
                           aria-label="@item.Title">

                            <div class="property-media">

                                <img src="@imageUrl"
                                     alt="@item.Title"
                                     loading="lazy"
                                     decoding="async"
                                     onerror="this.onerror=null;this.src='@fallbackImage';">

                                <div class="property-tags">

                                    @if (item.IsFeatured)
                                    {
                                        <span class="badge accent">
                                            Öne Çıkan
                                        </span>
                                    }
                                    else if (isNew)
                                    {
                                        <span class="badge accent">
                                            Yeni
                                        </span>
                                    }

                                    <span class="badge">
                                        @listingTypeText
                                    </span>

                                </div>

                            </div>

                            <div class="property-body">

                                <div class="property-price">
                                    ₺@item.Price.ToString("N0")@priceSuffix
                                </div>

                                <h3>@item.Title</h3>

                                <div class="location">

                                    <svg class="icon"
                                         width="15"
                                         height="15"
                                         viewBox="0 0 24 24"
                                         aria-hidden="true">
                                        <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0ZM12 12a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"></path>
                                    </svg>

                                    @item.District, @item.City
                                </div>

                                <p class="card-description">
                                    @description
                                </p>

                                <div class="specs">

                                    <span class="spec">

                                        <svg class="icon"
                                             width="16"
                                             height="16"
                                             viewBox="0 0 24 24"
                                             aria-hidden="true">
                                            <path d="M3 19v-6h18v6M5 13V7h6a3 3 0 0 1 3 3v3M5 19v2M19 19v2"></path>
                                        </svg>

                                        @item.RoomCount+@item.LivingRoomCount
                                    </span>

                                    <span class="spec">

                                        <svg class="icon"
                                             width="16"
                                             height="16"
                                             viewBox="0 0 24 24"
                                             aria-hidden="true">
                                            <path d="M4 18 18 4l2 2L6 20l-2-2Zm8-8 2 2m-5 1 2 2"></path>
                                        </svg>

                                        @item.GrossSquareMeter m²
                                    </span>

                                    <span class="spec">

                                        <svg class="icon"
                                             width="16"
                                             height="16"
                                             viewBox="0 0 24 24"
                                             aria-hidden="true">
                                            <path d="M4 12h16v3a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4v-3Zm3 0V7a3 3 0 0 1 6 0"></path>
                                        </svg>

                                        @item.BathroomCount Banyo
                                    </span>

                                </div>

                            </div>

                        </a>

                    </article>
                }

            </div>
        }
        else
        {
            <div class="home-property-empty">

                <svg class="icon"
                     width="30"
                     height="30"
                     viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M3 10.5 12 3l9 7.5V21H3V10.5ZM9 21v-6h6v6"></path>
                </svg>

                <strong>Henüz yayınlanmış ilan bulunmuyor</strong>

                <span>
                    Yeni ilanlar yayınlandığında burada
                    görüntülenecektir.
                </span>

            </div>
        }

    </div>
</section>