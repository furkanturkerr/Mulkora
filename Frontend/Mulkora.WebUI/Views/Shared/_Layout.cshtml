<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#173a31">
    <meta name="description" content="Mülkora emlak platformu">
    <title>Mülkora</title>
    <link rel="icon" href="~/Mulkora_Full_Theme_With_Panels/assets/images/favicon.svg">
    <link rel="stylesheet" href="~/Mulkora_Full_Theme_With_Panels/assets/css/theme.css">
</head>
<body>
<header class="site-header">
    <div class="container">
        <nav class="nav-shell" aria-label="Ana menü">
            <a class="logo" asp-controller="Default" asp-action="Index">
                <img src="~/Mulkora_Full_Theme_With_Panels/assets/images/logo.svg" alt="Mülkora"><span>Mülk<strong>ora</strong></span>
            </a>
            <div class="nav-menu">
                <a class="active" asp-controller="Default" asp-action="Index">Ana Sayfa</a>
                <a class="" asp-controller="Default" asp-action="Index">İlanlar</a>
                <a class="" asp-controller="Agent" asp-action="Index">Danışmanlar</a>
                <a class="" asp-controller="About" asp-action="Index">Hakkımızda</a>
                <a class="" asp-controller="Contact" asp-action="Index">İletişim</a>
            </div>
            <div class="nav-actions">
                <a class="icon-btn" asp-controller="Default" asp-action="Index" aria-label="Favoriler">
                    <svg class="icon" width="19" height="19" viewBox="0 0 24 24" aria-hidden="true">
                        <path
                            d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21.2l8.8-8.8a5.5 5.5 0 0 0 0-7.8Z"/>
                    </svg>
                </a><a class="btn btn-primary" asp-controller="Account" asp-action="Login">Giriş Yap</a>
                <button class="menu-toggle" type="button" aria-label="Menüyü aç" aria-expanded="false">
                    <svg class="icon" width="21" height="21" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4 7h16M4 12h16M4 17h16"/>
                    </svg>
                </button>
            </div>
        </nav>
    </div>
</header>
<main>
    @RenderBody()
</main>
<footer class="site-footer">
    <div class="container">
        <div class="footer-grid">
            <div class="footer-brand"><a class="logo" href="index.html"><img src="~/Mulkora_Full_Theme_With_Panels/assets/images/logo.svg" alt="Mülkora"><span>Mülk<strong>ora</strong></span></a>
                <p>Doğrulanmış ilanlar, uzman danışmanlar ve kolay ev gösterim randevuları için modern emlak
                    platformu.</p>
                <div class="socials"><a href="#" aria-label="Instagram">in</a><a href="#" aria-label="X">x</a><a
                        href="#" aria-label="LinkedIn">li</a></div>
            </div>
            <div>
                <div class="footer-title">Keşfet</div>
                <div class="footer-links"><a href="properties.html">Satılık ilanlar</a><a href="properties.html">Kiralık
                        ilanlar</a><a href="agents.html">Danışmanlar</a><a href="favorites.html">Favoriler</a></div>
            </div>
            <div>
                <div class="footer-title">Mülkora</div>
                <div class="footer-links"><a href="about.html">Hakkımızda</a><a href="faq.html">Sık sorulanlar</a><a
                        href="contact.html">İletişim</a><a href="terms.html">Kullanım koşulları</a></div>
            </div>
            <div>
                <div class="footer-title">Bize ulaşın</div>
                <div class="footer-contact"><span><svg class="icon" width="16" height="16" viewBox="0 0 24 24"
                                                       aria-hidden="true"><path
                                d="M5 4h4l2 5-3 2a16 16 0 0 0 5 5l2-3 5 2v4a2 2 0 0 1-2 2C10 21 3 14 3 6a2 2 0 0 1 2-2Z"/></svg> 0850 000 00 00</span><span><svg
                            class="icon" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path
                                d="M4 5h16v14H4V5Zm0 2 8 6 8-6"/></svg> merhaba@mulkora.com</span><span><svg
                            class="icon"
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            aria-hidden="true"><path
                                d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0ZM12 12a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/></svg> İstanbul, Türkiye</span>
                </div>
            </div>
        </div>
        <div class="footer-bottom"><span>© 2026 Mülkora. Tüm hakları saklıdır.</span><span><a href="privacy.html">Gizlilik</a> · <a
                    href="terms.html">Koşullar</a></span></div>
    </div>
</footer>
<div class="toast" role="status" aria-live="polite">
    <svg class="icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
        <path d="m5 12 4 4L19 6"/>
    </svg>
    <span data-toast-text>İşlem tamamlandı.</span></div>
<button class="back-top" type="button" aria-label="Yukarı dön">
    <svg class="icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
        <path d="m6 15 6-6 6 6"/>
    </svg>
</button>
<script src="~/Mulkora_Full_Theme_With_Panels/assets/js/theme.js"></script>
</body>
</html>