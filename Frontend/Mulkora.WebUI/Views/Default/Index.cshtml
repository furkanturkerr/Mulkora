@model dynamic

@{
    Layout = "_Layout";
}

    <section class="hero">
        <div class="container">
            <div class="hero-shell">
                <div class="hero-copy"><span class="hero-kicker">Doğrulanmış ilanlar · Kolay randevu</span>
                    <h1>Evi aramak değil, <em>doğru evi bulmak.</em></h1>
                    <p class="hero-lead">Satılık ve kiralık portföyleri keşfedin, danışmanla size uygun saatte ev
                        gösterim randevusu oluşturun.</p>
                    <div class="hero-stats">
                        <div><strong>1.250+</strong><span>Aktif ilan</span></div>
                        <div><strong>180+</strong><span>Uzman danışman</span></div>
                        <div><strong>4.9/5</strong><span>Memnuniyet</span></div>
                    </div>
                </div>
                <div class="hero-visual">
                    <div class="hero-card">
                        <div><small>Öne çıkan ilan</small><strong>Modern Bahçe Villası</strong></div>
                        <div class="price"><small>Satış fiyatı</small><strong>₺18.750.000</strong></div>
                    </div>
                </div>
                <form class="search-box" action="properties.html"><input type="hidden" name="listingType" value="sale">
                    <div class="search-tabs">
                        <button class="search-tab active" data-type="sale" type="button">Satılık</button>
                        <button class="search-tab" data-type="rent" type="button">Kiralık</button>
                    </div>
                    <div class="search-grid">
                        <div class="field"><label>Konum</label><input name="location" placeholder="İl veya ilçe ara">
                        </div>
                        <div class="field"><label>Emlak tipi</label><select>
                            <option>Tümü</option>
                            <option>Daire</option>
                            <option>Villa</option>
                            <option>Rezidans</option>
                            <option>Arsa</option>
                        </select></div>
                        <div class="field"><label>Oda</label><select>
                            <option>Tümü</option>
                            <option>1+1</option>
                            <option>2+1</option>
                            <option>3+1</option>
                            <option>4+1</option>
                        </select></div>
                        <div class="field"><label>Maksimum fiyat</label><select>
                            <option>Farketmez</option>
                            <option>₺5.000.000</option>
                            <option>₺10.000.000</option>
                            <option>₺20.000.000</option>
                        </select></div>
                        <button class="search-submit" aria-label="İlan ara">
                            <svg class="icon" width="21" height="21" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14Zm5-2 4 4"/>
                            </svg>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </section>
<section class="section-sm">
    <div class="container">

        <div class="home-category-grid">

            <a class="home-category-card reveal" asp-controller="Property" asp-action="Index">

                <div class="home-category-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <rect x="5" y="2.5" width="14" height="19" rx="2"/>
                        <path d="M9 6.5h2"/>
                        <path d="M13 6.5h2"/>
                        <path d="M9 10.5h2"/>
                        <path d="M13 10.5h2"/>
                        <path d="M9 14.5h2"/>
                        <path d="M13 14.5h2"/>
                        <path d="M10 21.5V18h4v3.5"/>
                    </svg>
                </div>

                <div class="home-category-content">
                    <strong>Daire</strong>
                    <span>564 güncel ilan</span>
                </div>

                <svg class="home-category-arrow"
                     viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="m9 18 6-6-6-6"/>
                </svg>

            </a>

            <a class="home-category-card reveal" asp-controller="Property" asp-action="Index">

                <div class="home-category-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <path d="M3 11.5 12 4l9 7.5"/>
                        <path d="M5.5 10v10.5h13V10"/>
                        <path d="M9 20.5v-6h6v6"/>
                        <path d="M8 11.5h2"/>
                        <path d="M14 11.5h2"/>
                    </svg>
                </div>

                <div class="home-category-content">
                    <strong>Villa</strong>
                    <span>186 seçkin ilan</span>
                </div>

                <svg class="home-category-arrow"
                     viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="m9 18 6-6-6-6"/>
                </svg>

            </a>

            <a class="home-category-card reveal" asp-controller="Property" asp-action="Index">

                <div class="home-category-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <circle cx="7.5" cy="15.5" r="4"/>
                        <path d="m10.5 12.5 9-9"/>
                        <path d="m16 7 2 2"/>
                        <path d="m18 5 2 2"/>
                    </svg>
                </div>

                <div class="home-category-content">
                    <strong>Kiralık</strong>
                    <span>318 hazır ilan</span>
                </div>

                <svg class="home-category-arrow"
                     viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="m9 18 6-6-6-6"/>
                </svg>

            </a>

            <a class="home-category-card reveal" asp-controller="Agent" asp-action="Index">

                <div class="home-category-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <circle cx="10" cy="7" r="4"/>
                        <path d="M3.5 20a6.5 6.5 0 0 1 13 0"/>
                        <path d="m16.5 13.5 1.7 1.7 3-3.2"/>
                    </svg>
                </div>

                <div class="home-category-content">
                    <strong>Danışman</strong>
                    <span>180 doğrulanmış profil</span>
                </div>

                <svg class="home-category-arrow"
                     viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="m9 18 6-6-6-6"/>
                </svg>

            </a>

        </div>

    </div>
</section>

    @await Component.InvokeAsync("_DefaultPropertyComponentPartial")
    
    <section class="section surface">
        <div class="container">
            <div class="section-title reveal">
                <div><span class="eyebrow">Popüler bölgeler</span>
                    <h2>Şehrin en çok aranan noktaları.</h2>
                    <p>Yaşam tarzınıza uygun bölgeleri ilan sayılarıyla birlikte keşfedin.</p></div>
            </div>
            <div class="region-grid"><a class="region-card reveal" href="properties.html"><img
                                                                                              src="assets/images/properties/property-07.svg" alt="İstanbul">
                <div class="region-content"><strong>İstanbul</strong><span>684 aktif ilan</span></div>
            </a><a class="region-card reveal" href="properties.html"><img src="assets/images/properties/property-03.svg"
                                                                          alt="İzmir">
                <div class="region-content"><strong>İzmir</strong><span>218 aktif ilan</span></div>
            </a><a class="region-card reveal" href="properties.html"><img src="assets/images/properties/property-06.svg"
                                                                          alt="Ankara">
                <div class="region-content"><strong>Ankara</strong><span>196 aktif ilan</span></div>
            </a><a class="region-card reveal" href="properties.html"><img src="assets/images/properties/property-04.svg"
                                                                          alt="Bursa">
                <div class="region-content"><strong>Bursa</strong><span>114 aktif ilan</span></div>
            </a><a class="region-card reveal" href="properties.html"><img src="assets/images/properties/property-05.svg"
                                                                          alt="Sakarya">
                <div class="region-content"><strong>Sakarya</strong><span>76 aktif ilan</span></div>
            </a></div>
        </div>
    </section>
    
    <section class="section">
        <div class="container">
            <div class="section-title reveal">
                <div><span class="eyebrow">Nasıl çalışır?</span>
                    <h2>Üç adımda evi yerinde görün.</h2></div>
            </div>
            <div class="steps">
                <div class="step-card reveal"><span class="step-no">01</span>
                    <h3>İlanı keşfedin</h3>
                    <p>Gelişmiş filtrelerle bütçenize ve yaşam tarzınıza uygun evleri bulun.</p></div>
                <div class="step-card reveal"><span class="step-no">02</span>
                    <h3>Saati seçin</h3>
                    <p>Danışmanın müsait takviminden size uygun gün ve saati belirleyin.</p></div>
                <div class="step-card reveal"><span class="step-no">03</span>
                    <h3>Randevuyu yönetin</h3>
                    <p>Onay durumunu takip edin, gerekirse tek yerden değiştirin veya iptal edin.</p></div>
            </div>
        </div>
    </section>
    
    <section class="section surface">
        <div class="container">
            <div class="section-title reveal">
                <div><span class="eyebrow">Uzman danışmanlar</span>
                    <h2>Bölgesini gerçekten bilen kişilerle ilerleyin.</h2></div>
                <a class="text-link" href="agents.html">Tüm danışmanlar
                    <svg class="icon" width="17" height="17" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M5 12h14M14 7l5 5-5 5"/>
                    </svg>
                </a></div>
            <div class="agent-grid">
                <article class="agent-card reveal"><a href="agent-detail.html">
                    <div class="agent-photo"><img src="assets/images/agents/agent-01.svg" alt="Selin Aksoy"></div>
                    <div class="agent-body"><h3>Selin Aksoy</h3>
                        <div class="agent-meta">İstanbul Avrupa Yakası</div>
                        <div class="rating">
                            <svg class="icon" width="15" height="15" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 16l-5.5 2.9 1.1-6.2L3 9.6l6.2-.9L12 3Z"/>
                            </svg>
                            4.9 · 32 ilan
                        </div>
                    </div>
                </a></article>
                <article class="agent-card reveal"><a href="agent-detail.html">
                    <div class="agent-photo"><img src="assets/images/agents/agent-02.svg" alt="Emre Kaya"></div>
                    <div class="agent-body"><h3>Emre Kaya</h3>
                        <div class="agent-meta">Ankara Çankaya</div>
                        <div class="rating">
                            <svg class="icon" width="15" height="15" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 16l-5.5 2.9 1.1-6.2L3 9.6l6.2-.9L12 3Z"/>
                            </svg>
                            4.8 · 24 ilan
                        </div>
                    </div>
                </a></article>
                <article class="agent-card reveal"><a href="agent-detail.html">
                    <div class="agent-photo"><img src="assets/images/agents/agent-03.svg" alt="Derya Aydın"></div>
                    <div class="agent-body"><h3>Derya Aydın</h3>
                        <div class="agent-meta">İzmir Sahil Hattı</div>
                        <div class="rating">
                            <svg class="icon" width="15" height="15" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 16l-5.5 2.9 1.1-6.2L3 9.6l6.2-.9L12 3Z"/>
                            </svg>
                            5.0 · 19 ilan
                        </div>
                    </div>
                </a></article>
                <article class="agent-card reveal"><a href="agent-detail.html">
                    <div class="agent-photo"><img src="assets/images/agents/agent-04.svg" alt="Mert Yalçın"></div>
                    <div class="agent-body"><h3>Mert Yalçın</h3>
                        <div class="agent-meta">Samsun Atakum</div>
                        <div class="rating">
                            <svg class="icon" width="15" height="15" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 16l-5.5 2.9 1.1-6.2L3 9.6l6.2-.9L12 3Z"/>
                            </svg>
                            4.9 · 27 ilan
                        </div>
                    </div>
                </a></article>
            </div>
        </div>
    </section>
    <section class="section">
        <div class="container">
            <div class="testimonial reveal">
                <div class="testimonial-media"></div>
                <div class="testimonial-copy"><span class="eyebrow" style="color:#efcfaa">Kullanıcı deneyimi</span>
                    <blockquote>“İlanı gördüğüm gün danışmanın uygun saatini seçtim. Ev gösterim süreci ilk kez bu kadar
                        düzenliydi.”
                    </blockquote>
                    <cite>Ayşe Demir · Mülkora kullanıcısı</cite></div>
            </div>
        </div>
    </section>
    <section class="section-sm">
        <div class="container">
            <div class="newsletter reveal">
                <div><h3>Yeni ilanları kaçırmayın.</h3>
                    <p>Seçtiğiniz bölgelerdeki yeni portföyleri e-posta ile alın.</p></div>
                <form class="newsletter-form" data-newsletter><input type="email" required
                                                                     placeholder="E-posta adresiniz">
                    <button class="btn btn-primary">Abone Ol</button>
                </form>
            </div>
        </div>
    </section>