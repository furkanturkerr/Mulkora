@model dynamic

@{
    Layout = "_Layout";
}

@await Component.InvokeAsync("_DefaultHeroComponentPartial")
<section class="section-sm">
    <div class="container">

        <div class="home-category-grid">

            <a class="home-category-card reveal" asp-controller="Property" asp-action="Index">

                <div class="home-category-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <rect x="5" y="2.5" width="14" height="19" rx="2"/>
                        <path d="M9 6.5h2"/>
                        <path d="M13 6.5h2"/>
                        <path d="M9 10.5h2"/>
                        <path d="M13 10.5h2"/>
                        <path d="M9 14.5h2"/>
                        <path d="M13 14.5h2"/>
                        <path d="M10 21.5V18h4v3.5"/>
                    </svg>
                </div>

                <div class="home-category-content">
                    <strong>Daire</strong>
                    <span>564 güncel ilan</span>
                </div>

                <svg class="home-category-arrow"
                     viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="m9 18 6-6-6-6"/>
                </svg>

            </a>

            <a class="home-category-card reveal" asp-controller="Property" asp-action="Index">

                <div class="home-category-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <path d="M3 11.5 12 4l9 7.5"/>
                        <path d="M5.5 10v10.5h13V10"/>
                        <path d="M9 20.5v-6h6v6"/>
                        <path d="M8 11.5h2"/>
                        <path d="M14 11.5h2"/>
                    </svg>
                </div>

                <div class="home-category-content">
                    <strong>Villa</strong>
                    <span>186 seçkin ilan</span>
                </div>

                <svg class="home-category-arrow"
                     viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="m9 18 6-6-6-6"/>
                </svg>

            </a>

            <a class="home-category-card reveal" asp-controller="Property" asp-action="Index">

                <div class="home-category-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <circle cx="7.5" cy="15.5" r="4"/>
                        <path d="m10.5 12.5 9-9"/>
                        <path d="m16 7 2 2"/>
                        <path d="m18 5 2 2"/>
                    </svg>
                </div>

                <div class="home-category-content">
                    <strong>Kiralık</strong>
                    <span>318 hazır ilan</span>
                </div>

                <svg class="home-category-arrow"
                     viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="m9 18 6-6-6-6"/>
                </svg>

            </a>

            <a class="home-category-card reveal" asp-controller="Agent" asp-action="Index">

                <div class="home-category-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <circle cx="10" cy="7" r="4"/>
                        <path d="M3.5 20a6.5 6.5 0 0 1 13 0"/>
                        <path d="m16.5 13.5 1.7 1.7 3-3.2"/>
                    </svg>
                </div>

                <div class="home-category-content">
                    <strong>Danışman</strong>
                    <span>180 doğrulanmış profil</span>
                </div>

                <svg class="home-category-arrow"
                     viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="m9 18 6-6-6-6"/>
                </svg>

            </a>

        </div>

    </div>
</section>

@await Component.InvokeAsync("_DefaultPropertyComponentPartial")

<section class="section surface">
    <div class="container">
        <div class="section-title reveal">
            <div>
                <span class="eyebrow">Popüler bölgeler</span>
                <h2>Şehrin en çok aranan noktaları.</h2>
                <p>Yaşam tarzınıza uygun bölgeleri ilan sayılarıyla birlikte keşfedin.</p>
            </div>
        </div>
        <div class="region-grid">
            <a class="region-card reveal" asp-controller="Property" asp-action="Index">

                <img
                    src="https://images.contentstack.io/v3/assets/blt06f605a34f1194ff/blt289d3aab2da77bc9/6777f31f93a84b03b5a37ef2/BCC-2023-EXPLORER-Istanbul-Fun-things-to-do-in-Istanbul-HEADER_MOBILE.jpg?fit=crop&auto=webp&quality=60&crop=smart&format=avif"
                    alt="İstanbul">
                <div class="region-content">
                    <strong>İstanbul</strong>
                    <span>684 aktif ilan
                        </span>
                </div>
            </a>
            <a class="region-card reveal" asp-controller="Property" asp-action="Index">
                <img src="https://blog.obilet.com/wp-content/uploads/2018/03/izmirgezilecekyerler-min-scaled.jpeg"
                     alt="İzmir">
                <div class="region-content">
                    <strong>İzmir</strong>
                    <span>218 aktif ilan</span>
                </div>
            </a>
            <a class="region-card reveal" asp-controller="Property" asp-action="Index">
                <img src="https://assets.enuygun.com/media/lib/570x400/uploads/image/ankara-35906.jpeg"
                     alt="Ankara">
                <div class="region-content">
                    <strong>Ankara</strong>
                    <span>196 aktif ilan</span>
                </div>
            </a>
            <a class="region-card reveal" asp-controller="Property" asp-action="Index">
                <img
                    src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcT5GHBjr7kp1bHiMPVkaxKHzuHslGj92I4YSlvbxrJr-DXrW34F3GdyuVg&s=10"
                    alt="Bursa">
                <div class="region-content">
                    <strong>Bursa</strong>
                    <span>114 aktif ilan</span>
                </div>
            </a>
            <a class="region-card reveal" asp-controller="Property" asp-action="Index">
                <img
                    src="https://www.emlakplatform.com.tr/storage/3049/Information-About-Sakarya-Province-in-Turkey.webp"
                    alt="Sakarya">
                <div class="region-content">
                    <strong>Sakarya</strong>
                    <span>76 aktif ilan</span>
                </div>
            </a>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-title reveal">
            <div><span class="eyebrow">Nasıl çalışır?</span>
                <h2>Üç adımda evi yerinde görün.</h2></div>
        </div>
        <div class="steps">
            <div class="step-card reveal"><span class="step-no">01</span>
                <h3>İlanı keşfedin</h3>
                <p>Gelişmiş filtrelerle bütçenize ve yaşam tarzınıza uygun evleri bulun.</p></div>
            <div class="step-card reveal"><span class="step-no">02</span>
                <h3>Saati seçin</h3>
                <p>Danışmanın müsait takviminden size uygun gün ve saati belirleyin.</p></div>
            <div class="step-card reveal"><span class="step-no">03</span>
                <h3>Randevuyu yönetin</h3>
                <p>Onay durumunu takip edin, gerekirse tek yerden değiştirin veya iptal edin.</p></div>
        </div>
    </div>
</section>

@await Component.InvokeAsync("_DefaultAgentComponentPartial")

<section class="section">
    <div class="container">
        <div class="testimonial reveal">
            <div class="testimonial-media"></div>
            <div class="testimonial-copy"><span class="eyebrow" style="color:#efcfaa">Kullanıcı deneyimi</span>
                <blockquote>“İlanı gördüğüm gün danışmanın uygun saatini seçtim. Ev gösterim süreci ilk kez bu kadar
                    düzenliydi.”
                </blockquote>
                <cite>Ayşe Demir · Mülkora kullanıcısı</cite></div>
        </div>
    </div>
</section>
<section class="section-sm">
    <div class="container">
        <div class="newsletter reveal">
            <div><h3>Yeni ilanları kaçırmayın.</h3>
                <p>Seçtiğiniz bölgelerdeki yeni portföyleri e-posta ile alın.</p></div>
            <form class="newsletter-form" data-newsletter><input type="email" required
                                                                 placeholder="E-posta adresiniz">
                <button class="btn btn-primary">Abone Ol</button>
            </form>
        </div>
    </div>
</section>