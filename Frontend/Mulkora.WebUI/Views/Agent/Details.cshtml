@model Mulkora.Dto.AgentDtos.UpdateAgentDto

@{
    Layout = "_Layout";
    ViewData["Title"] = $"{Model.Name} {Model.Surname}";
}

<section class="detail-header">
    <div class="container">

        <div class="breadcrumbs" style="color:var(--muted)">
            <a asp-controller="Default" asp-action="Index">Ana Sayfa</a>
            <span>/</span>
            <a asp-controller="Agent" asp-action="Index">Danışmanlar</a>
            <span>/</span>
            <span>@Model.Name @Model.Surname</span>
        </div>

        <div class="detail-card">
            <div class="agent-detail-header">

                <img class="agent-detail-photo"
                     src="@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? Url.Content("~/images/default-agent.png") : Model.ImageUrl)"
                     alt="@Model.Name @Model.Surname">

                <div class="agent-detail-main">
                    <span class="badge success">Doğrulanmış danışman</span>

                    <h1>@Model.Name @Model.Surname</h1>

                    <p class="muted agent-detail-title">
                        @(string.IsNullOrWhiteSpace(Model.Title) ? "Emlak danışmanı" : Model.Title)
                    </p>

                    <div class="agent-detail-summary">
                        <span>
                            <svg class="icon" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path>
                                <circle cx="12" cy="10" r="2"></circle>
                            </svg>

                            @if (!string.IsNullOrWhiteSpace(Model.City) && !string.IsNullOrWhiteSpace(Model.District))
                            {
                                <text>@Model.City / @Model.District</text>
                            }
                            else if (!string.IsNullOrWhiteSpace(Model.City))
                            {
                                <text>@Model.City</text>
                            }
                            else
                            {
                                <text>Konum belirtilmedi</text>
                            }
                        </span>

                        <span>
                            <svg class="icon" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                                <circle cx="12" cy="12" r="9"></circle>
                                <path d="M12 7v5"></path>
                                <path d="m12 12 3 2"></path>
                            </svg>

                            @Model.ExperienceYear yıl deneyim
                        </span>
                    </div>
                </div>

                <div class="agent-detail-actions">
                    <a href="#contact" class="btn btn-primary">
                        <svg class="icon" width="17" height="17" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 5h16v11H9l-5 4V5Z"></path>
                        </svg>
                        İletişime geç
                    </a>

                    @if (!string.IsNullOrWhiteSpace(Model.Email))
                    {
                        <a href="mailto:@Model.Email" class="btn btn-outline">
                            <svg class="icon" width="17" height="17" viewBox="0 0 24 24" aria-hidden="true">
                                <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                                <path d="m3 7 9 6 9-6"></path>
                            </svg>
                            E-posta gönder
                        </a>
                    }
                </div>

            </div>
        </div>

    </div>
</section>

<section class="section-sm">
    <div class="container">

        <div class="detail-layout">

            <div>
                <section class="detail-card">
                    <h2>Hakkında</h2>

                    <p class="muted">
                        @(string.IsNullOrWhiteSpace(Model.About)
                            ? "Danışman hakkında henüz açıklama eklenmemiş."
                            : Model.About)
                    </p>
                </section>

                <section class="detail-card">
                    <h2>Danışman bilgileri</h2>

                    <div class="feature-grid">

                        <div class="feature">
                            <span class="checkmark">
                                <svg class="icon" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="m5 12 4 4L19 6"></path>
                                </svg>
                            </span>

                            <div>
                                <span class="muted">Deneyim</span>
                                <strong>@Model.ExperienceYear yıl</strong>
                            </div>
                        </div>

                        <div class="feature">
                            <span class="checkmark">
                                <svg class="icon" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="m5 12 4 4L19 6"></path>
                                </svg>
                            </span>

                            <div>
                                <span class="muted">Ofis</span>
                                <strong>@(string.IsNullOrWhiteSpace(Model.OfficeName) ? "Belirtilmedi" : Model.OfficeName)</strong>
                            </div>
                        </div>

                        <div class="feature">
                            <span class="checkmark">
                                <svg class="icon" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="m5 12 4 4L19 6"></path>
                                </svg>
                            </span>

                            <div>
                                <span class="muted">Şehir</span>
                                <strong>@(string.IsNullOrWhiteSpace(Model.City) ? "Belirtilmedi" : Model.City)</strong>
                            </div>
                        </div>

                        <div class="feature">
                            <span class="checkmark">
                                <svg class="icon" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="m5 12 4 4L19 6"></path>
                                </svg>
                            </span>

                            <div>
                                <span class="muted">İlçe</span>
                                <strong>@(string.IsNullOrWhiteSpace(Model.District) ? "Belirtilmedi" : Model.District)</strong>
                            </div>
                        </div>

                        <div class="feature">
                            <span class="checkmark">
                                <svg class="icon" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="m5 12 4 4L19 6"></path>
                                </svg>
                            </span>

                            <div>
                                <span class="muted">Lisans numarası</span>
                                <strong>@(string.IsNullOrWhiteSpace(Model.LicenseNumber) ? "Belirtilmedi" : Model.LicenseNumber)</strong>
                            </div>
                        </div>

                        <div class="feature">
                            <span class="checkmark">
                                <svg class="icon" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="m5 12 4 4L19 6"></path>
                                </svg>
                            </span>

                            <div>
                                <span class="muted">Hesap durumu</span>
                                <strong>Aktif ve doğrulanmış</strong>
                            </div>
                        </div>

                    </div>
                </section>
            </div>

            <aside id="contact">
                <div class="detail-card sticky-card">
                    <h2>İletişim</h2>

                    <div class="contact-list">

                        @if (!string.IsNullOrWhiteSpace(Model.Email))
                        {
                            <a href="mailto:@Model.Email" class="btn btn-primary btn-block">
                                <svg class="icon" width="17" height="17" viewBox="0 0 24 24" aria-hidden="true">
                                    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                                    <path d="m3 7 9 6 9-6"></path>
                                </svg>
                                E-posta gönder
                            </a>
                        }

                        <a asp-controller="Agent" asp-action="Index" class="btn btn-outline btn-block">
                            <svg class="icon" width="17" height="17" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M15 18 9 12l6-6"></path>
                            </svg>
                            Danışmanlara dön
                        </a>

                    </div>

                    <div class="schedule-list">
                        <div>
                            <span>Ofis</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.OfficeName) ? "Belirtilmedi" : Model.OfficeName)</strong>
                        </div>

                        <div>
                            <span>Bölge</span>

                            <strong>
                                @if (!string.IsNullOrWhiteSpace(Model.City) && !string.IsNullOrWhiteSpace(Model.District))
                                {
                                    <text>@Model.City / @Model.District</text>
                                }
                                else
                                {
                                    <text>Belirtilmedi</text>
                                }
                            </strong>
                        </div>

                        <div>
                            <span>Deneyim</span>
                            <strong>@Model.ExperienceYear yıl</strong>
                        </div>
                    </div>
                </div>
            </aside>

        </div>

    </div>
</section>