@model List<Mulkora.Dto.AgentDtos.ResultAgentDto>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Danışmanlar";
}

<section class="page-hero">
    <div class="container">
        <div class="page-hero-shell">

            <div class="breadcrumbs">
                <a asp-controller="Default" asp-action="Index">Ana Sayfa</a>
                <span>/</span>
                <span>Danışmanlar</span>
            </div>

            <div class="page-title">
                <h1>Doğrulanmış emlak danışmanları</h1>
                <p>Bölgesini, fiyatları ve süreci bilen uzmanlarla güvenle ilerleyin.</p>
            </div>

        </div>
    </div>
</section>

<section class="section-sm">
    <div class="container">

        <div class="listing-toolbar">

            <div>
                <strong>@(Model?.Count ?? 0) danışman</strong>

                <div class="muted" style="font-size:13px">
                    Türkiye genelinde doğrulanmış profiller
                </div>
            </div>

        </div>

        @if (Model == null || Model.Count == 0)
        {
            <div class="empty-state">

                <div class="empty-state-icon">
                    <svg class="icon" width="30" height="30" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="8" r="4"/>
                        <path d="M5 21a7 7 0 0 1 14 0"/>
                    </svg>
                </div>

                <h2>Henüz danışman bulunmuyor</h2>

                <p>
                    Sisteme eklenen danışmanlar burada görüntülenecek.
                </p>

            </div>
        }
        else
        {
            <div class="agent-grid">

                @foreach (var agent in Model)
                {
                    <article class="agent-card reveal">

                        <a asp-controller="Agent" asp-action="Details" asp-route-id="@agent.AgentId">

                            <div class="agent-photo">
                                <img src="@(string.IsNullOrWhiteSpace(agent.ImageUrl) ? Url.Content("~/assets/images/agents/agent-01.svg") : agent.ImageUrl)" alt="@agent.Name @agent.Surname">
                            </div>

                            <div class="agent-body">

                                <h3>@agent.Name @agent.Surname</h3>

                                <div class="agent-meta">
                                    @if (!string.IsNullOrWhiteSpace(agent.City) || !string.IsNullOrWhiteSpace(agent.District))
                                    {
                                        <span>
                                            @agent.City
                                            @if (!string.IsNullOrWhiteSpace(agent.City) && !string.IsNullOrWhiteSpace(agent.District))
                                            {
                                                <text> / </text>
                                            }
                                            @agent.District
                                        </span>
                                    }
                                    else
                                    {
                                        <span>Konum belirtilmedi</span>
                                    }
                                </div>

                                <div class="rating">
                                    
                                    @if (agent.IsVerified == true)
                                    {
                                        <div class="rating">
                                            <svg class="icon" width="15" height="15" viewBox="0 0 24 24" aria-hidden="true">
                                                <path d="m12 3 2.4 2.2 3.2-.4.8 3.1 2.8 1.7-1.4 3 1.4 3-2.8 1.7-.8 3.1-3.2-.4L12 21l-2.4-2.2-3.2.4-.8-3.1-2.8-1.7 1.4-3-1.4-3 2.8-1.7.8-3.1 3.2.4Z"/>
                                                <path d="m9 12 2 2 4-4"/>
                                            </svg>

                                            Doğrulanmış · @agent.ExperienceYear yıl deneyim
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="rating">
                                            <svg class="icon" width="15" height="15" viewBox="0 0 24 24" aria-hidden="true">
                                                <path d="m12 3 2.4 2.2 3.2-.4.8 3.1 2.8 1.7-1.4 3 1.4 3-2.8 1.7-.8 3.1-3.2-.4L12 21l-2.4-2.2-3.2.4-.8-3.1-2.8-1.7 1.4-3-1.4-3 2.8-1.7.8-3.1 3.2.4Z"/>
                                                <path d="m9 12 2 2 4-4"/>
                                            </svg>

                                            Doğrulanmamış · @agent.ExperienceYear yıl deneyim
                                        </div>
                                    }

                                </div>

                            </div>

                        </a>

                    </article>
                }

            </div>
        }

    </div>
</section>