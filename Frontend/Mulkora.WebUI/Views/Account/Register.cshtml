@model Mulkora.Dto.AuthDtos.RegisterDto

@{
    Layout = null;
}

<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Hesap oluşturun · Mülkora</title>

    <link rel="icon"
          href="~/Mulkora_Full_Theme_With_Panels/assets/images/favicon.svg">

    <link rel="stylesheet"
          href="~/Mulkora_Full_Theme_With_Panels/assets/css/theme.css">
</head>

<body>

<main class="auth-page">
    <div class="auth-shell">

        <aside class="auth-visual">

            <a class="logo auth-brand"
               asp-controller="Default"
               asp-action="Index">

                <img src="~/Mulkora_Full_Theme_With_Panels/assets/images/logo.svg"
                     alt="Mülkora">

                <span>
                    Mülk<strong>ora</strong>
                </span>
            </a>

            <div class="auth-quote">
                <h2>Aradığınız evi bulmak artık daha düzenli.</h2>

                <p>
                    Doğrulanmış ilanları keşfedin ve ev gösterim
                    randevunuzu kolayca oluşturun.
                </p>
            </div>

        </aside>

        <section class="auth-form-wrap">
            <div class="auth-form">

                <a class="text-link"
                   asp-controller="Default"
                   asp-action="Index">

                    <svg class="icon"
                         width="16"
                         height="16"
                         viewBox="0 0 24 24"
                         aria-hidden="true">

                        <path d="m15 18-6-6 6-6"/>
                    </svg>

                    Ana sayfaya dön
                </a>

                <h1>Hesap oluşturun</h1>

                <p>
                    Favori ilanlarınızı kaydedin ve randevularınızı
                    kolayca takip edin.
                </p>

                <form asp-controller="Account"
                      asp-action="Register"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="validation-summary">
                    </div>

                    <div class="form-grid">

                        <div class="form-group">
                            <label asp-for="Name">Ad</label>

                            <input asp-for="Name"
                                   class="input"
                                   placeholder="Adınız"
                                   autocomplete="given-name">

                            <span asp-validation-for="Name"
                                  class="validation">
                            </span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Surname">Soyad</label>

                            <input asp-for="Surname"
                                   class="input"
                                   placeholder="Soyadınız"
                                   autocomplete="family-name">

                            <span asp-validation-for="Surname"
                                  class="validation">
                            </span>
                        </div>

                        <div class="form-group full">
                            <label asp-for="Email">E-posta</label>

                            <input asp-for="Email"
                                   class="input"
                                   type="email"
                                   placeholder="ornek@mail.com"
                                   autocomplete="email">

                            <span asp-validation-for="Email"
                                  class="validation">
                            </span>
                        </div>

                        <div class="form-group full">

                            <label asp-for="Password">Şifre</label>

                            <div class="password-wrap">

                                <input asp-for="Password"
                                       class="input"
                                       type="password"
                                       placeholder="En az 8 karakter"
                                       autocomplete="new-password">

                                <button class="password-toggle"
                                        type="button"
                                        aria-label="Şifreyi göster">

                                    <svg class="icon"
                                         width="18"
                                         height="18"
                                         viewBox="0 0 24 24"
                                         aria-hidden="true">

                                        <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Zm9.5 2.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"/>
                                    </svg>

                                </button>
                            </div>

                            <span class="help">
                                En az 8 karakter, bir büyük harf ve bir rakam kullanın.
                            </span>

                            <span asp-validation-for="Password"
                                  class="validation">
                            </span>
                        </div>

                        <div class="form-group full">

                            <label class="check">

                                <input type="checkbox"
                                       name="AcceptTerms"
                                       value="true"
                                       required>

                                <span>
                                    <a href="/terms"
                                       target="_blank">
                                        Kullanım koşullarını
                                    </a>

                                    ve

                                    <a href="/privacy"
                                       target="_blank">
                                        gizlilik politikasını
                                    </a>

                                    kabul ediyorum.
                                </span>

                            </label>

                        </div>

                        <div class="form-group full">

                            <button class="btn btn-primary btn-block"
                                    type="submit">

                                Hesap Oluştur
                            </button>

                        </div>

                    </div>
                </form>

                <div class="auth-bottom">
                    Zaten hesabınız var mı?

                    <a asp-controller="Account"
                       asp-action="Login">

                        Giriş yapın
                    </a>
                </div>

            </div>
        </section>

    </div>
</main>

<div class="toast" role="status">
    <span data-toast-text>İşlem tamamlandı.</span>
</div>

<script src="~/Mulkora_Full_Theme_With_Panels/assets/js/theme.js"></script>

<partial name="_ValidationScriptsPartial"/>

</body>
</html>