@model Mulkora.Dto.AuthDtos.ResetPasswordDto

@{
    Layout = null;
    ViewData["Title"] = "Yeni Şifre Belirle";
}

<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#173a31">

    <title>@ViewData["Title"] · Mülkora</title>

    <link rel="icon" href="~/Mulkora_Full_Theme_With_Panels/assets/images/favicon.svg">
    <link rel="stylesheet" href="~/Mulkora_Full_Theme_With_Panels/assets/css/theme.css">
</head>
<body>
<main class="auth-page">
    <div class="auth-shell">
        <aside class="auth-visual">
            <a class="logo auth-brand" asp-controller="Default" asp-action="Index">
                <img src="~/Mulkora_Full_Theme_With_Panels/assets/images/logo.svg" alt="Mülkora">
                <span>Mülk<strong>ora</strong></span>
            </a>

            <div class="auth-quote">
                <h2>Güvenliğiniz, ev arama deneyiminizin bir parçası.</h2>
                <p>
                    Yeni şifrenizi belirleyin ve favorilerinizi,
                    randevularınızı yönetmeye devam edin.
                </p>
            </div>
        </aside>

        <section class="auth-form-wrap">
            <div class="auth-form">
                <a class="text-link" asp-controller="Account" asp-action="Login">
                    <svg class="icon" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="m15 18-6-6 6-6"/>
                    </svg>
                    Giriş sayfasına dön
                </a>

                <h1>Yeni şifre belirleyin</h1>
                <p>
                    Güçlü ve daha önce kullanmadığınız bir şifre seçin.
                </p>

                <div class="notice">
                    <svg class="icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 3 5 6v5c0 4.5 2.9 8.1 7 10 4.1-1.9 7-5.5 7-10V6l-7-3Zm0 5v5m0 3h.01"/>
                    </svg>
                    <span>
                        Şifreniz en az 6 karakter; büyük harf, küçük harf
                        ve rakam içermelidir.
                    </span>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="ModelOnly" class="notice danger" style="margin-top: 16px"></div>
                }

                <form asp-controller="Account"
                      asp-action="ResetPassword"
                      method="post"
                      style="margin-top: 18px">

                    <input asp-for="Email" type="hidden">
                    <input asp-for="Token" type="hidden">

                    <div class="form-group">
                        <label asp-for="NewPassword">Yeni şifre</label>
                        <div class="password-wrap">
                            <input asp-for="NewPassword"
                                   class="input"
                                   type="password"
                                   autocomplete="new-password"
                                   placeholder="Yeni şifreniz">

                            <button class="password-toggle"
                                    type="button"
                                    aria-label="Şifreyi göster veya gizle">
                                <svg class="icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Zm9.5 2.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"/>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="validation" style="display: block"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ConfirmPassword">Yeni şifre tekrar</label>
                        <div class="password-wrap">
                            <input asp-for="ConfirmPassword"
                                   class="input"
                                   type="password"
                                   autocomplete="new-password"
                                   placeholder="Yeni şifrenizi tekrar girin">

                            <button class="password-toggle"
                                    type="button"
                                    aria-label="Şifreyi göster veya gizle">
                                <svg class="icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Zm9.5 2.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"/>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="validation" style="display: block"></span>
                    </div>

                    <button class="btn btn-primary btn-block" type="submit">
                        Şifremi Güncelle
                    </button>
                </form>
            </div>
        </section>
    </div>
</main>

<script src="~/Mulkora_Full_Theme_With_Panels/assets/js/theme.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
