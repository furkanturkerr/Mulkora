@{
    Layout = null;
}

<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>E-postanızı kontrol edin · Mülkora</title>

    <link rel="icon"
          href="~/Mulkora_Full_Theme_With_Panels/assets/images/favicon.svg">

    <link rel="stylesheet"
          href="~/Mulkora_Full_Theme_With_Panels/assets/css/theme.css">

    <style>
        .mail-status-icon {
            width: 72px;
            height: 72px;
            display: grid;
            place-items: center;
            margin-bottom: 26px;
            border-radius: 22px;
            background: #e8f2ee;
            color: #178268;
        }

        .mail-status-icon svg {
            width: 32px;
            height: 32px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.9;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .mail-status-note {
            margin: 26px 0 30px;
            padding: 16px 18px;
            border: 1px solid #e1e8e5;
            border-radius: 14px;
            background: #f7faf8;
            color: #5e6b67;
            font-size: 14px;
            line-height: 1.65;
        }
    </style>
</head>

<body>

<main class="auth-page">
    <div class="auth-shell">

        <aside class="auth-visual">

            <a class="logo auth-brand"
               asp-controller="Default"
               asp-action="Index">

                <img src="~/Mulkora_Full_Theme_With_Panels/assets/images/logo.svg"
                     alt="Mülkora">

                <span>Mülk<strong>ora</strong></span>
            </a>

            <div class="auth-quote">
                <h2>Yeni bağlantınız hazırlanıyor.</h2>

                <p>
                    Hesabınız kayıtlı ve henüz doğrulanmamışsa
                    yeni doğrulama bağlantısı e-posta adresinize gönderildi.
                </p>
            </div>

        </aside>

        <section class="auth-form-wrap">
            <div class="auth-form">

                <a class="text-link"
                   asp-controller="Default"
                   asp-action="Index">

                    <svg class="icon"
                         width="16"
                         height="16"
                         viewBox="0 0 24 24"
                         aria-hidden="true">

                        <path d="m15 18-6-6 6-6"/>
                    </svg>

                    Ana sayfaya dön
                </a>

                <div class="mail-status-icon">

                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="3" y="5" width="18" height="14" rx="2"/>
                        <path d="m3 7 9 6 9-6"/>
                        <path d="m17 3 2 2 3-3"/>
                    </svg>

                </div>

                <h1>E-postanızı kontrol edin</h1>

                <p>
                    E-posta adresiniz sistemde kayıtlı ve hesabınız henüz
                    doğrulanmamışsa yeni doğrulama bağlantısı gönderildi.
                </p>

                <div class="mail-status-note">
                    E-posta birkaç dakika içinde görünmezse spam,
                    gereksiz veya tanıtımlar klasörünü kontrol edin.
                </div>

                <a class="btn btn-primary btn-block"
                   asp-controller="Account"
                   asp-action="Login">

                    Giriş sayfasına git
                </a>

                <div class="auth-bottom">
                    E-posta hâlâ gelmedi mi?

                    <a asp-controller="Account"
                       asp-action="ResendConfirmationEmail">

                        Tekrar deneyin
                    </a>
                </div>

            </div>
        </section>

    </div>
</main>

<script src="~/Mulkora_Full_Theme_With_Panels/assets/js/theme.js"></script>

</body>
</html>