@model Mulkora.Dto.AuthDtos.ForgotPasswordDto

@{
    Layout = null;
    ViewData["Title"] = "Şifremi Unuttum";
}

<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#173a31">

    <title>@ViewData["Title"] · Mülkora</title>

    <link rel="icon" href="~/Mulkora_Full_Theme_With_Panels/assets/images/favicon.svg">
    <link rel="stylesheet" href="~/Mulkora_Full_Theme_With_Panels/assets/css/theme.css">
</head>
<body>
<main class="auth-page">
    <div class="auth-shell">
        <aside class="auth-visual">
            <a class="logo auth-brand" asp-controller="Default" asp-action="Index">
                <img src="~/Mulkora_Full_Theme_With_Panels/assets/images/logo.svg" alt="Mülkora">
                <span>Mülk<strong>ora</strong></span>
            </a>

            <div class="auth-quote">
                <h2>Hesabınıza yeniden ulaşmanız çok kolay.</h2>
                <p>
                    Doğrulanmış ilanları keşfedin ve ev gösterim
                    randevunuzu kolayca oluşturun.
                </p>
            </div>
        </aside>

        <section class="auth-form-wrap">
            <div class="auth-form">
                <a class="text-link" asp-controller="Default" asp-action="Index">
                    <svg class="icon" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="m15 18-6-6 6-6"/>
                    </svg>
                    Ana sayfaya dön
                </a>

                <h1>Şifrenizi mi unuttunuz?</h1>
                <p>
                    Hesabınıza ait e-posta adresini yazın.
                    Şifre yenileme bağlantısını size gönderelim.
                </p>

                <div class="notice">
                    <svg class="icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4 5h16v14H4V5Zm0 2 8 6 8-6"/>
                    </svg>
                    <span>
                        Güvenlik nedeniyle e-posta adresinin sistemde kayıtlı olup
                        olmadığını ekranda göstermeyiz.
                    </span>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="ModelOnly" class="notice danger" style="margin-top: 16px"></div>
                }

                <form asp-controller="Account"
                      asp-action="ForgotPassword"
                      method="post"
                      style="margin-top: 18px">

                    <div class="form-group">
                        <label asp-for="Email">E-posta adresi</label>
                        <input asp-for="Email"
                               class="input"
                               type="email"
                               autocomplete="email"
                               placeholder="ornek@mail.com">
                        <span asp-validation-for="Email" class="validation" style="display: block"></span>
                    </div>

                    <button class="btn btn-primary btn-block" type="submit">
                        Şifre Sıfırlama Bağlantısı Gönder
                    </button>
                </form>

                <div class="auth-bottom">
                    Şifrenizi hatırladınız mı?
                    <a asp-controller="Account" asp-action="Login">Giriş yapın</a>
                </div>
            </div>
        </section>
    </div>
</main>

<script src="~/Mulkora_Full_Theme_With_Panels/assets/js/theme.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
