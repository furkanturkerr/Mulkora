@{
    Layout = null;
    ViewData["Title"] = "Bağlantı Gönderildi";
}

<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#173a31">

    <title>@ViewData["Title"] · Mülkora</title>

    <link rel="icon" href="~/Mulkora_Full_Theme_With_Panels/assets/images/favicon.svg">
    <link rel="stylesheet" href="~/Mulkora_Full_Theme_With_Panels/assets/css/theme.css">
</head>
<body>
<main class="auth-page">
    <div class="auth-shell">
        <aside class="auth-visual">
            <a class="logo auth-brand" asp-controller="Default" asp-action="Index">
                <img src="~/Mulkora_Full_Theme_With_Panels/assets/images/logo.svg" alt="Mülkora">
                <span>Mülk<strong>ora</strong></span>
            </a>

            <div class="auth-quote">
                <h2>Yeni yaşamınıza kaldığınız yerden devam edin.</h2>
                <p>
                    Hesabınızın güvenliğini korurken işlemlerinizi
                    olabildiğince kolaylaştırıyoruz.
                </p>
            </div>
        </aside>

        <section class="auth-form-wrap">
            <div class="auth-form" style="text-align: center">
                <div class="success-icon" aria-hidden="true">
                    <svg class="icon" width="44" height="44" viewBox="0 0 24 24">
                        <path d="m5 12 4 4L19 6"/>
                    </svg>
                </div>

                <h1>E-postanızı kontrol edin</h1>
                <p>
                    E-posta adresiniz sistemde kayıtlıysa şifre sıfırlama
                    bağlantısını gönderdik.
                </p>

                <div class="notice success" style="margin: 24px 0; text-align: left">
                    <svg class="icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4 5h16v14H4V5Zm0 2 8 6 8-6"/>
                    </svg>
                    <span>
                        Gelen kutusunda göremiyorsanız spam veya gereksiz
                        klasörünü de kontrol edin. Bağlantının süresi sınırlıdır.
                    </span>
                </div>

                <a class="btn btn-primary btn-block"
                   asp-controller="Account"
                   asp-action="Login">
                    Giriş Sayfasına Dön
                </a>

                <div class="auth-bottom">
                    E-posta gelmedi mi?
                    <a asp-controller="Account" asp-action="ForgotPassword">
                        Yeniden gönderin
                    </a>
                </div>
            </div>
        </section>
    </div>
</main>

<script src="~/Mulkora_Full_Theme_With_Panels/assets/js/theme.js"></script>
</body>
</html>
