@model Mulkora.Dto.ContactDtos.CreateContactDto

@{
    Layout = "_Layout";
}

<section class="page-hero">
    <div class="container">
        <div class="page-hero-shell">
            <div class="breadcrumbs">
                <a asp-controller="Default" asp-action="Index">Ana Sayfa</a><span>/</span><span>İletişim</span>
            </div>
            <div class="page-title">
                <h1>Bizimle iletişime geçin.</h1>
                <p>İlan, randevu veya hesap işlemleriyle ilgili sorularınız için buradayız.</p></div>
        </div>
    </div>
</section>
<section class="section-sm">
    <div class="container">
        <div class="detail-layout">
            <div class="form-card">
                <h2 style="margin-top:0">Mesaj gönderin</h2>
                <form asp-action="CreateMessage" method="post" class="form-grid">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label>Ad soyad</label>
                        <input asp-for="NameSurname" class="input" required>
                        <span class="validation">Bu alan zorunludur.</span>
                    </div>

                    <div class="form-group">
                        <label>E-posta</label>
                        <input asp-for="Email" class="input" type="email" required>
                        <span class="validation">Geçerli e-posta girin.</span>
                    </div>

                    <div class="form-group full">
                        <label>Konu</label>
                        <select asp-for="Subject" class="select">
                            <option value="Genel destek">Genel destek</option>
                            <option value="İlan bildirimi">İlan bildirimi</option>
                            <option value="Randevu sorunu">Randevu sorunu</option>
                            <option value="Hesap işlemleri"> Hesap işlemleri</option>
                        </select>
                    </div>

                    <div class="form-group full">
                        <label>Mesajınız</label>
                        <textarea asp-for="MessageText" class="textarea" required></textarea>
                        <span class="validation">Mesajınızı yazın.</span>
                    </div>
                    <div class="form-group full">
                        <button type="submit" class="btn btn-primary">Mesajı Gönder</button>
                    </div>
                </form>
            </div>
            <aside>
                <div class="detail-card">
                    <h2>İletişim bilgileri</h2>
                    <div class="contact-list">
                        <div class="notice">
                            <svg class="icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                                <path
                                    d="M5 4h4l2 5-3 2a16 16 0 0 0 5 5l2-3 5 2v4a2 2 0 0 1-2 2C10 21 3 14 3 6a2 2 0 0 1 2-2Z"/>
                            </svg>
                            0850 000 00 00
                        </div>
                        <div class="notice">
                            <svg class="icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M4 5h16v14H4V5Zm0 2 8 6 8-6"/>
                            </svg>
                            merhaba@mulkora.com
                        </div>
                        <div class="notice">
                            <svg class="icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                                <path
                                    d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0ZM12 12a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/>
                            </svg>
                            İstanbul, Türkiye
                        </div>
                    </div>
                    <div class="map-placeholder" style="min-height:220px;margin-top:18px">
                        <div class="map-pin">
                            <svg class="icon" width="26" height="26" viewBox="0 0 24 24" aria-hidden="true">
                                <path
                                    d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0ZM12 12a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/>
                            </svg>
                        </div>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</section>