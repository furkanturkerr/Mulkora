@model List<Mulkora.Dto.AppointmentDtos.ResultAppointmentDto>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Randevularım";

    var now = DateTime.Now;
    var totalCount = Model?.Count ?? 0;

    var upcomingCount = Model?
        .Count(x => x.AppointmentDate >= now) ?? 0;

    var approvedCount = Model?
        .Count(x =>
            x.AppointmentDate >= now &&
            x.IsStatus) ?? 0;

    var pastCount = Model?
        .Count(x => x.AppointmentDate < now) ?? 0;
}

<link rel="stylesheet"
      href="~/css/my-appointments.css"
      asp-append-version="true">

<main class="member-appointment-page">

    <section class="member-appointment-hero">

        <div class="member-hero-circle member-circle-one"></div>
        <div class="member-hero-circle member-circle-two"></div>

        <div class="member-appointment-breadcrumb">

            <a asp-controller="Default"
               asp-action="Index">
                Ana Sayfa
            </a>

            <span>/</span>
            <strong>Randevularım</strong>

        </div>

        <div class="member-appointment-hero-content">

            <div>
                <span class="member-appointment-eyebrow">
                    RANDEVU TAKİBİ
                </span>

                <h1>Randevularım</h1>

                <p>
                    Oluşturduğunuz ev gösterim taleplerini,
                    randevu tarihlerini ve güncel durumlarını
                    buradan takip edin.
                </p>
            </div>

            <div class="member-appointment-hero-date">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M5 4h14a2 2 0 0 1 2 2v14H3V6a2 2 0 0 1 2-2Z"></path>
                    <path d="M7 2v4M17 2v4M3 9h18"></path>
                </svg>

                <div>
                    <span>Bugün</span>

                    <strong>
                        @now.ToString("dd.MM.yyyy")
                    </strong>
                </div>

            </div>

        </div>

    </section>

    <section class="member-appointment-summary">

        <article class="member-summary-card">

            <div class="member-summary-icon summary-total">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M5 4h14a2 2 0 0 1 2 2v14H3V6a2 2 0 0 1 2-2Z"></path>
                    <path d="M7 2v4M17 2v4M3 9h18"></path>
                </svg>

            </div>

            <div>
                <span>Toplam randevu</span>
                <strong>@totalCount</strong>
            </div>

        </article>

        <article class="member-summary-card">

            <div class="member-summary-icon summary-upcoming">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <circle cx="12"
                            cy="12"
                            r="9">
                    </circle>

                    <path d="M12 7v5l3 2"></path>
                </svg>

            </div>

            <div>
                <span>Yaklaşan randevu</span>
                <strong>@upcomingCount</strong>
            </div>

        </article>

        <article class="member-summary-card">

            <div class="member-summary-icon summary-approved">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="m5 12 4 4L19 6"></path>
                </svg>

            </div>

            <div>
                <span>Onaylanan randevu</span>
                <strong>@approvedCount</strong>
            </div>

        </article>

        <article class="member-summary-card">

            <div class="member-summary-icon summary-past">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <circle cx="12"
                            cy="12"
                            r="9">
                    </circle>

                    <path d="M12 7v5l3 2"></path>
                </svg>

            </div>

            <div>
                <span>Geçmiş randevu</span>
                <strong>@pastCount</strong>
            </div>

        </article>

    </section>

    <section class="member-appointment-content">

        <header class="member-appointment-content-header">

            <div>
                <span class="member-content-label">
                    RANDEVU LİSTESİ
                </span>

                <h2>Ev gösterim talepleriniz</h2>

                <p>
                    Toplam @totalCount randevu kaydınız bulunuyor.
                </p>
            </div>

            <a asp-controller="Property"
               asp-action="Index"
               class="member-property-list-button">

                Yeni ilanları incele

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="m9 18 6-6-6-6"></path>
                </svg>

            </a>

        </header>

        @if (Model != null && Model.Any())
        {
            <div class="member-appointment-list">

                @foreach (var item in Model
                    .OrderByDescending(x => x.AppointmentDate))
                {
                    var isPast =
                        item.AppointmentDate < now;

                    var statusText = isPast
                        ? "Geçmiş"
                        : item.IsStatus
                            ? "Onaylandı"
                            : "Reddedildi";

                    var statusClass = isPast
                        ? "member-status-past"
                        : item.IsStatus
                            ? "member-status-approved"
                            : "member-status-rejected";

                    <article class="member-appointment-card">

                        <div class="member-property-image">

                            <img src="~/Mulkora_Full_Theme_With_Panels/assets/images/properties/property-01.svg"
                                 alt="@item.Title">

                            <span class="member-appointment-status @statusClass">
                                <span></span>
                                @statusText
                            </span>

                        </div>

                        <div class="member-appointment-information">

                            <span class="member-property-number">
                                İlan #@item.PropertyId
                            </span>

                            <h3>@item.Title</h3>

                            <div class="member-property-location">

                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true">
                                    <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path>

                                    <circle cx="12"
                                            cy="10"
                                            r="2">
                                    </circle>
                                </svg>

                                <span>
                                    @item.PropertyAddress
                                </span>

                            </div>

                            <div class="member-appointment-meta">

                                <div class="member-meta-item">

                                    <span class="member-meta-icon">

                                        <svg viewBox="0 0 24 24"
                                             aria-hidden="true">
                                            <path d="M5 4h14a2 2 0 0 1 2 2v14H3V6a2 2 0 0 1 2-2Z"></path>
                                            <path d="M7 2v4M17 2v4M3 9h18"></path>
                                        </svg>

                                    </span>

                                    <div>
                                        <small>Randevu tarihi</small>

                                        <strong>
                                            @item.AppointmentDate.ToString("dd.MM.yyyy")
                                        </strong>
                                    </div>

                                </div>

                                <div class="member-meta-item">

                                    <span class="member-meta-icon">

                                        <svg viewBox="0 0 24 24"
                                             aria-hidden="true">
                                            <circle cx="12"
                                                    cy="12"
                                                    r="9">
                                            </circle>

                                            <path d="M12 7v5l3 2"></path>
                                        </svg>

                                    </span>

                                    <div>
                                        <small>Randevu saati</small>

                                        <strong>
                                            @item.AppointmentDate.ToString("HH:mm")
                                        </strong>
                                    </div>

                                </div>

                                <div class="member-meta-item">

                                    <span class="member-meta-icon">

                                        <svg viewBox="0 0 24 24"
                                             aria-hidden="true">
                                            <circle cx="12"
                                                    cy="8"
                                                    r="4">
                                            </circle>

                                            <path d="M5 21a7 7 0 0 1 14 0"></path>
                                        </svg>

                                    </span>

                                    <div>
                                        <small>Danışman</small>

                                        <strong>
                                            @item.AgentNameSurname
                                        </strong>
                                    </div>

                                </div>

                            </div>

                        </div>

                        <div class="member-appointment-side">

                            <div class="member-date-box">

                                <strong>
                                    @item.AppointmentDate.ToString("dd")
                                </strong>

                                <span>
                                    @item.AppointmentDate.ToString("MM.yyyy")
                                </span>

                            </div>

                            <a asp-controller="Property"
                               asp-action="Details"
                               asp-route-id="@item.PropertyId"
                               class="member-detail-button">

                                İlanı Gör

                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true">
                                    <path d="m9 18 6-6-6-6"></path>
                                </svg>

                            </a>

                        </div>

                    </article>
                }

            </div>
        }
        else
        {
            <div class="member-appointment-empty">

                <div class="member-empty-icon">

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="M5 4h14a2 2 0 0 1 2 2v14H3V6a2 2 0 0 1 2-2Z"></path>
                        <path d="M7 2v4M17 2v4M3 9h18"></path>
                        <path d="M8 14h8"></path>
                    </svg>

                </div>

                <h2>Henüz randevunuz bulunmuyor</h2>

                <p>
                    İlgilendiğiniz ilanlardan randevu oluşturarak
                    evleri yerinde görebilirsiniz.
                </p>

                <a asp-controller="Property"
                   asp-action="Index"
                   class="member-empty-button">
                    İlanları İncele
                </a>

            </div>
        }

    </section>

</main>