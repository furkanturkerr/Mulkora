@model Mulkora.Dto.CategoryDtos.CreateCategoryDto

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Yeni Kategori Ekle";
}

<link rel="stylesheet"
      href="~/css/admin/category.css"
      asp-append-version="true">

<div class="category-form-page">

    <div class="category-form-heading">

        <div>
            <h1>Yeni Kategori Ekle</h1>

            <p>
                İlanlarda kullanılacak yeni kategori
                bilgilerini oluşturun.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Category"
           asp-action="Index"
           class="category-back-button">

            <svg viewBox="0 0 24 24"
                 aria-hidden="true">
                <path d="m15 18-6-6 6-6"></path>
            </svg>

            Kategorilere Dön
        </a>

    </div>

    <section class="category-form-card">

        <div class="category-form-card-heading">

            <div class="category-form-icon">
                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M4 4h6v6H4V4Z"></path>
                    <path d="M14 4h6v6h-6V4Z"></path>
                    <path d="M4 14h6v6H4v-6Z"></path>
                    <path d="M17 14v6M14 17h6"></path>
                </svg>
            </div>

            <div>
                <h2>Kategori bilgileri</h2>

                <p>
                    Kategori adını ve kullanılabilirlik
                    durumunu belirleyin.
                </p>
            </div>

        </div>

        <form asp-area="Admin"
              asp-controller="Category"
              asp-action="Create"
              method="post"
              class="category-form">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All"
                 class="category-validation-summary">
            </div>

            <div class="category-form-grid">

                <div class="category-field">
                    <label asp-for="Name">
                        Kategori adı
                    </label>

                    <input asp-for="Name"
                           type="text"
                           placeholder="Örn: Daire">

                    <span asp-validation-for="Name"
                          class="category-field-error">
                    </span>
                </div>

                <div class="category-field">
                    <label asp-for="IsActive">
                        Kategori durumu
                    </label>

                    <select asp-for="IsActive">
                        <option value="">Durum seçin</option>
                        <option value="true">Aktif</option>
                        <option value="false">Pasif</option>
                    </select>

                    <span asp-validation-for="IsActive"
                          class="category-field-error">
                    </span>
                </div>

            </div>

            <div class="category-form-information">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <circle cx="12"
                            cy="12"
                            r="9">
                    </circle>
                    <path d="M12 11v5M12 8h.01"></path>
                </svg>

                <p>
                    Aktif kategoriler ilan ekleme ve
                    güncelleme ekranlarında kullanılabilir.
                    Pasif kategoriler yeni ilanlarda seçilemez.
                </p>

            </div>

            <div class="category-form-actions">

                <a asp-area="Admin"
                   asp-controller="Category"
                   asp-action="Index"
                   class="category-cancel-button">
                    Vazgeç
                </a>

                <button type="submit"
                        class="category-save-button">

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="M5 3h12l2 2v16H5V3Z"></path>
                        <path d="M8 3v6h8V3"></path>
                        <path d="M8 21v-7h8v7"></path>
                    </svg>

                    Kategoriyi Kaydet
                </button>

            </div>

        </form>

    </section>

</div>