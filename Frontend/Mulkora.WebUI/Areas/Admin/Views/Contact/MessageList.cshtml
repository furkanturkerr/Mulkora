@model List<Mulkora.Dto.ContactDtos.ResultContactDto>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "İletişim Mesajları";

    var currentPage =
        ViewBag.CurrentPage is int page && page > 0
            ? page
            : 1;

    var hasNextPage =
        ViewBag.HasNextPage is bool next && next;

    var messageCount = Model?.Count ?? 0;
}

<link rel="stylesheet"
      href="~/css/admin/contact.css"
      asp-append-version="true">

<div class="contact-page">

    <header class="contact-page-header">

        <div>
            <h1>İletişim Mesajları</h1>

            <p>
                İletişim sayfasından gönderilen mesajları
                görüntüleyin ve yönetin.
            </p>
        </div>

        <div class="contact-page-count">

            <span class="contact-page-count-icon">
                <svg width="17"
                     height="17"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8">

                    <rect x="3"
                          y="5"
                          width="18"
                          height="14"
                          rx="2">
                    </rect>

                    <path d="m3 7 9 6 9-6"></path>
                </svg>
            </span>

            <div>
                <strong>@messageCount</strong>
                <span>Bu sayfadaki mesaj</span>
            </div>

        </div>

    </header>

    <section class="contact-card">

        <div class="contact-card-header">

            <div>
                <strong>Gelen kutusu</strong>

                <span>
                    Sayfa @currentPage üzerinde
                    @messageCount mesaj gösteriliyor
                </span>
            </div>

        </div>

        @if (Model != null && Model.Any())
        {
            <div class="contact-table-wrapper">

                <table class="contact-table">

                    <thead>
                    <tr>
                        <th>Gönderen</th>
                        <th>Konu</th>
                        <th>Mesaj</th>
                        <th class="contact-actions-title">
                            İşlemler
                        </th>
                    </tr>
                    </thead>

                    <tbody>

                    @foreach (var contact in Model)
                    {
                        var senderName =
                            string.IsNullOrWhiteSpace(
                                contact.NameSurname)
                                ? "İsimsiz kullanıcı"
                                : contact.NameSurname;

                        var email =
                            string.IsNullOrWhiteSpace(contact.Email)
                                ? "E-posta belirtilmedi"
                                : contact.Email;

                        var subject =
                            string.IsNullOrWhiteSpace(contact.Subject)
                                ? "Konu belirtilmedi"
                                : contact.Subject;

                        var message =
                            string.IsNullOrWhiteSpace(
                                contact.MessageText)
                                ? "Mesaj içeriği bulunmuyor."
                                : contact.MessageText;

                        <tr>

                            <td data-label="Gönderen">

                                <div class="contact-sender">

                                    <div class="contact-sender-avatar">
                                        <svg width="19"
                                             height="19"
                                             viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.8">

                                            <circle cx="12"
                                                    cy="8"
                                                    r="4">
                                            </circle>

                                            <path d="M5 21a7 7 0 0 1 14 0">
                                            </path>
                                        </svg>
                                    </div>

                                    <div class="contact-sender-info">

                                        <strong>
                                            @senderName
                                        </strong>

                                        @if (!string.IsNullOrWhiteSpace(
                                            contact.Email))
                                        {
                                            <a href="mailto:@contact.Email">
                                                @contact.Email
                                            </a>
                                        }
                                        else
                                        {
                                            <span>@email</span>
                                        }

                                    </div>

                                </div>

                            </td>

                            <td data-label="Konu">

                                <span class="contact-subject">
                                    @subject
                                </span>

                            </td>

                            <td data-label="Mesaj">

                                <p class="contact-message">
                                    @message
                                </p>

                            </td>

                            <td data-label="İşlemler">

                                <div class="contact-actions">

                                    @if (!string.IsNullOrWhiteSpace(
                                        contact.Email))
                                    {
                                        <a href="mailto:@contact.Email"
                                           class="contact-action reply"
                                           title="E-posta gönder">

                                            <svg width="16"
                                                 height="16"
                                                 viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="1.8">

                                                <path d="M4 5h16v14H4V5Z">
                                                </path>

                                                <path d="m4 7 8 6 8-6">
                                                </path>
                                            </svg>

                                            Yanıtla
                                        </a>
                                    }

                                    <form asp-area="Admin"
                                          asp-controller="Contact"
                                          asp-action="Delete"
                                          asp-route-id="@contact.ContactId"
                                          method="post"
                                          class="contact-delete-form">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="contact-action delete"
                                                title="Mesajı sil"
                                                onclick="return confirm(
                                                'Bu mesajı silmek istediğinize emin misiniz?')">

                                            <svg width="16"
                                                 height="16"
                                                 viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="1.8">

                                                <path d="M3 6h18">
                                                </path>

                                                <path d="M8 6V4h8v2">
                                                </path>

                                                <path d="m19 6-1 14H6L5 6">
                                                </path>

                                                <path d="M10 10v6">
                                                </path>

                                                <path d="M14 10v6">
                                                </path>
                                            </svg>

                                            Sil
                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="contact-empty">

                <div class="contact-empty-icon">

                    <svg width="31"
                         height="31"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.7">

                        <rect x="3"
                              y="5"
                              width="18"
                              height="14"
                              rx="2">
                        </rect>

                        <path d="m3 7 9 6 9-6"></path>
                    </svg>

                </div>

                <h2>Henüz mesaj bulunmuyor</h2>

                <p>
                    İletişim sayfasından gönderilen mesajlar
                    burada görüntülenecek.
                </p>

            </div>
        }

    </section>

    @if (Model != null && Model.Any())
    {
        <nav class="contact-pagination"
             aria-label="Mesaj sayfalama">

            @if (currentPage > 1)
            {
                <a asp-area="Admin"
                   asp-controller="Contact"
                   asp-action="MessageList"
                   asp-route-page="@(currentPage - 1)"
                   class="contact-pagination-button">

                    <svg width="16"
                         height="16"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8">

                        <path d="m15 18-6-6 6-6">
                        </path>
                    </svg>

                    Önceki
                </a>
            }
            else
            {
                <span class="contact-pagination-button disabled">

                    <svg width="16"
                         height="16"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8">

                        <path d="m15 18-6-6 6-6">
                        </path>
                    </svg>

                    Önceki
                </span>
            }

            <span class="contact-pagination-current">
                @currentPage
            </span>

            @if (hasNextPage)
            {
                <a asp-area="Admin"
                   asp-controller="Contact"
                   asp-action="MessageList"
                   asp-route-page="@(currentPage + 1)"
                   class="contact-pagination-button">

                    Sonraki

                    <svg width="16"
                         height="16"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8">

                        <path d="m9 18 6-6-6-6">
                        </path>
                    </svg>

                </a>
            }
            else
            {
                <span class="contact-pagination-button disabled">

                    Sonraki

                    <svg width="16"
                         height="16"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8">

                        <path d="m9 18 6-6-6-6">
                        </path>
                    </svg>

                </span>
            }

        </nav>
    }

</div>