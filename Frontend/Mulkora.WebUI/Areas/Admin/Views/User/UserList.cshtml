@model List<Mulkora.Dto.UserDtos.ResultUserDto>

@{
Layout = "_AdminLayout";
ViewData["Title"] = "Kullanıcı Yönetimi";
}

<link rel="stylesheet"
      href="~/css/admin/user.css"
      asp-append-version="true">

<div class="users-page">

    <div class="users-heading">
        <div>
            <h1>Kullanıcı Yönetimi</h1>

            <p>
                Sistemde kayıtlı kullanıcıları görüntüleyin,
                rollerini düzenleyin ve hesaplarını yönetin.
            </p>
        </div>
    </div>

    <section class="users-card">

        <div class="users-card-heading">
            <div>
                <strong>Kullanıcı listesi</strong>

                <span>
                    Sistemde toplam @(Model?.Count ?? 0) kullanıcı bulunuyor
                </span>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
        <div class="users-table-wrapper">

            <table class="users-table">
                <thead>
                <tr>
                    <th>Kullanıcı</th>
                    <th>E-posta adresi</th>
                    <th>E-posta durumu</th>
                    <th class="users-actions-heading">İşlemler</th>
                </tr>
                </thead>

                <tbody>

                @foreach (var item in Model)
                {
                var nameInitial =
                string.IsNullOrWhiteSpace(item.Name)
                ? "K"
                : item.Name.Substring(0, 1).ToUpper();

                var surnameInitial =
                string.IsNullOrWhiteSpace(item.Surname)
                ? ""
                : item.Surname.Substring(0, 1).ToUpper();

                <tr>

                    <td>
                        <div class="user-info">

                            <div class="user-avatar">
                                @nameInitial@surnameInitial
                            </div>

                            <div class="user-identity">
                                <strong>
                                    @item.Name @item.Surname
                                </strong>

                                <span>
                                            Kayıtlı kullanıcı
                                        </span>
                            </div>

                        </div>
                    </td>

                    <td>
                        <div class="user-email">
                                    <span class="user-email-icon">
                                        <svg viewBox="0 0 24 24"
                                             aria-hidden="true">
                                            <rect x="3"
                                                  y="5"
                                                  width="18"
                                                  height="14"
                                                  rx="2">
                                            </rect>
                                            <path d="m3 7 9 6 9-6"></path>
                                        </svg>
                                    </span>

                            <span>@item.Email</span>
                        </div>
                    </td>

                    <td>
                        @if (item.EmailConfirmed)
                        {
                        <span class="user-status user-status-confirmed">
                                        <span class="user-status-dot"></span>
                                        Doğrulandı
                                    </span>
                        }
                        else
                        {
                        <span class="user-status user-status-pending">
                                        <span class="user-status-dot"></span>
                                        Doğrulanmadı
                                    </span>
                        }
                    </td>

                    <td>
                        <div class="user-actions">

                            <a asp-area="Admin"
                               asp-controller="User"
                               asp-action="RoleAssign"
                               asp-route-id="@item.Id"
                               class="user-action user-action-role">

                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true">
                                    <path d="M12 3 4 7v5c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V7l-8-4Z"></path>
                                    <path d="M9 12h6"></path>
                                    <path d="M12 9v6"></path>
                                </svg>

                                Rol Ata
                            </a>

                            <form asp-area="Admin"
                                  asp-controller="User"
                                  asp-action="Delete"
                                  asp-route-id="@item.Id"
                                  method="post"
                                  class="user-delete-form">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="user-action user-action-delete"
                                        onclick="return confirm('Bu kullanıcıyı silmek istediğinize emin misiniz?')">

                                    <svg viewBox="0 0 24 24"
                                         aria-hidden="true">
                                        <path d="M3 6h18"></path>
                                        <path d="M8 6V4h8v2"></path>
                                        <path d="m19 6-1 14H6L5 6"></path>
                                        <path d="M10 10v6M14 10v6"></path>
                                    </svg>

                                    Sil
                                </button>

                            </form>

                        </div>
                    </td>

                </tr>
                }

                </tbody>
            </table>

        </div>
        }
        else
        {
        <div class="users-empty">

            <div class="users-empty-icon">
                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9.5"
                            cy="7"
                            r="4">
                    </circle>
                    <path d="M18 8v6M15 11h6"></path>
                </svg>
            </div>

            <h2>Kullanıcı bulunamadı</h2>

            <p>
                Sistemde henüz kayıtlı kullanıcı bulunmuyor.
            </p>

        </div>
        }

    </section>

</div>