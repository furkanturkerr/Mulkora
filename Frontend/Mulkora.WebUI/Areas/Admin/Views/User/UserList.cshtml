@model List<Mulkora.Dto.UserDtos.ResultUserDto>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Kullanıcılar";
}

<style>
    .users-page {
        padding: 32px;
    }

    .users-header {
        margin-bottom: 24px;
    }

    .users-header h1 {
        margin: 0;
        font-size: 24px;
        font-weight: 700;
        color: #111827;
    }

    .users-header p {
        margin: 6px 0 0;
        font-size: 14px;
        color: #6b7280;
    }

    .users-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        overflow: hidden;
    }

    .users-table {
        width: 100%;
        border-collapse: collapse;
    }

    .users-table th {
        padding: 14px 18px;
        text-align: left;
        background: #f9fafb;
        border-bottom: 1px solid #e5e7eb;
        color: #6b7280;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .users-table td {
        padding: 16px 18px;
        border-bottom: 1px solid #f1f1f1;
        color: #374151;
        font-size: 14px;
        vertical-align: middle;
    }

    .users-table tbody tr:last-child td {
        border-bottom: none;
    }

    .users-table tbody tr:hover {
        background: #fafafa;
    }

    .user-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .user-avatar {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: #f3f4f6;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #374151;
        font-size: 13px;
        font-weight: 700;
        flex-shrink: 0;
    }

    .user-info strong {
        display: block;
        color: #111827;
        font-size: 14px;
    }

    .user-info span {
        display: block;
        margin-top: 3px;
        color: #9ca3af;
        font-size: 12px;
    }

    .status {
        display: inline-flex;
        align-items: center;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-confirmed {
        background: #ecfdf5;
        color: #047857;
    }

    .status-pending {
        background: #fff7ed;
        color: #c2410c;
    }

    .user-actions {
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .user-action {
        height: 34px;
        padding: 0 11px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #fff;
        color: #4b5563;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: .2s;
    }

    .user-action:hover {
        background: #f3f4f6;
        color: #111827;
    }

    .user-action.role {
        background: #111827;
        border-color: #111827;
        color: #fff;
    }

    .user-action.role:hover {
        background: #1f2937;
        color: #fff;
    }

    .user-action.delete:hover {
        background: #fef2f2;
        border-color: #fecaca;
        color: #dc2626;
    }

    .delete-form {
        margin: 0;
    }

    .empty-users {
        padding: 50px 20px;
        text-align: center;
        color: #9ca3af;
    }

    @@media (max-width: 900px) {
        .users-page {
            padding: 20px;
        }

        .users-card {
            overflow-x: auto;
        }

        .users-table {
            min-width: 800px;
        }
    }
</style>


<div class="users-page">

    <div class="users-header">
        <h1>Kullanıcı Yönetimi</h1>
        <p>Sistemde kayıtlı kullanıcıları görüntüleyin ve yönetin.</p>
    </div>

    <div class="users-card">

        @if (Model != null && Model.Any())
        {
            <table class="users-table">
                <thead>
                <tr>
                    <th>Kullanıcı</th>
                    <th>E-posta</th>
                    <th>E-posta Durumu</th>
                    <th style="width: 300px;">İşlemler</th>
                </tr>
                </thead>

                <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            <div class="user-info">

                                <div class="user-avatar">
                                    @item.Name.Substring(0, 1)@item.Surname.Substring(0, 1)
                                </div>

                                <div>
                                    <strong>@item.Name @item.Surname</strong>
                                    <span>Kullanıcı</span>
                                </div>

                            </div>
                        </td>

                        <td>
                            @item.Email
                        </td>

                        <td>
                            @if (item.EmailConfirmed)
                            {
                                <span class="status status-confirmed">Doğrulandı</span>
                            }
                            else
                            {
                                <span class="status status-pending">Doğrulanmadı</span>
                            }
                        </td>

                        <td>
                            <div class="user-actions">

                                <a asp-area="Admin"
                                   asp-controller="User"
                                   asp-action="RoleAssign"
                                   asp-route-id="@item.Id"
                                   class="user-action role">
                                    Rol Ata
                                </a>

                                <form asp-area="Admin"
                                      asp-controller="User"
                                      asp-action="Delete"
                                      asp-route-id="@item.Id"
                                      method="post"
                                      class="delete-form">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="user-action delete"
                                            onclick="return confirm('Bu kullanıcıyı silmek istediğinize emin misiniz?')">

                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                            <path d="M3 6h18"/>
                                            <path d="M8 6V4h8v2"/>
                                            <path d="m19 6-1 14H6L5 6"/>
                                            <path d="M10 10v6M14 10v6"/>
                                        </svg>

                                        Sil
                                    </button>

                                </form>

                            </div>
                        </td>

                    </tr>
                }

                </tbody>
            </table>
        }
        else
        {
            <div class="empty-users">
                Sistemde kayıtlı kullanıcı bulunamadı.
            </div>
        }

    </div>

</div>