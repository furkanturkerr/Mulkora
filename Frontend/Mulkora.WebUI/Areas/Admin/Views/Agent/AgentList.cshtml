@model List<Mulkora.Dto.AgentDtos.ResultAgentDto>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Danışman Yönetimi";

    string? text = ViewBag.Text;
    bool? isTrue = ViewBag.IsTrue;
}

<link rel="stylesheet"
      href="~/css/admin/agent.css"
      asp-append-version="true">

<div class="agents-page">

    <div class="agents-heading">
        <div>
            <h1>Danışman Yönetimi</h1>

            <p>
                Danışman profillerini, doğrulama durumlarını
                ve hesap erişimlerini yönetin.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Agent"
           asp-action="Create"
           class="agents-add-button">

            <svg viewBox="0 0 24 24"
                 aria-hidden="true">
                <path d="M12 5v14"></path>
                <path d="M5 12h14"></path>
            </svg>

            Danışman Ekle
        </a>
    </div>

    <form asp-area="Admin"
          asp-controller="Agent"
          asp-action="AgentList"
          method="get"
          class="agents-filter">

        <div class="agents-search">
            <svg viewBox="0 0 24 24"
                 aria-hidden="true">
                <circle cx="11"
                        cy="11"
                        r="7">
                </circle>
                <path d="m16.5 16.5 4 4"></path>
            </svg>

            <input type="search"
                   name="text"
                   value="@text"
                   placeholder="Danışman adı, soyadı, e-posta veya şehir ara">
        </div>

        <div class="agents-filter-item">
            <select id="isTrue"
                    name="isTrue"
                    aria-label="Danışman durumu">

                <option value="">
                    Tüm durumlar
                </option>

                <option value="true"
                        selected="@(isTrue == true ? "selected" : null)">
                    Aktif
                </option>

                <option value="false"
                        selected="@(isTrue == false ? "selected" : null)">
                    Pasif
                </option>
            </select>
        </div>

        <div class="agents-filter-actions">

            <button type="submit"
                    class="agents-filter-button">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M4 5h16"></path>
                    <path d="M7 12h10"></path>
                    <path d="M10 19h4"></path>
                </svg>

                Filtrele
            </button>

            <a asp-area="Admin"
               asp-controller="Agent"
               asp-action="AgentList"
               class="agents-clear-button">
                Temizle
            </a>

        </div>
    </form>

    <div class="agents-list-heading">
        <div>
            <strong>Danışman listesi</strong>

            <span>
                Bu sayfada @(Model?.Count ?? 0) danışman gösteriliyor
            </span>
        </div>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="agents-empty">

            <div class="agents-empty-icon">
                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <circle cx="10"
                            cy="8"
                            r="4">
                    </circle>
                    <path d="M3 21a7 7 0 0 1 14 0"></path>
                    <path d="M19 4v6"></path>
                    <path d="M16 7h6"></path>
                </svg>
            </div>

            <h2>Danışman bulunamadı</h2>

            <p>
                Arama kriterlerine uygun danışman bulunmuyor.
            </p>

            <a asp-area="Admin"
               asp-controller="Agent"
               asp-action="Create"
               class="agents-add-button">
                Danışman Ekle
            </a>
        </div>
    }
    else
    {
        <div class="agents-grid">

            @foreach (var agent in Model)
            {
                <article class="agent-card">

                    <div class="agent-card-header">

                        <div class="agent-profile">

                            <img src="@(string.IsNullOrWhiteSpace(agent.ImageUrl)
                                          ? Url.Content("~/Mulkora_Full_Theme_With_Panels/assets/images/agents/agent-01.svg")
                                          : agent.ImageUrl)"
                                 alt="@agent.Name @agent.Surname">

                            <div class="agent-profile-info">

                                <h2>
                                    @agent.Name @agent.Surname
                                </h2>

                                <span class="agent-title">
                                    @(string.IsNullOrWhiteSpace(agent.Title)
                                        ? "Emlak Danışmanı"
                                        : agent.Title)
                                </span>

                                <span class="agent-location">
                                    <svg viewBox="0 0 24 24"
                                         aria-hidden="true">
                                        <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path>
                                        <circle cx="12"
                                                cy="10"
                                                r="2">
                                        </circle>
                                    </svg>

                                    @agent.City / @agent.District
                                </span>

                            </div>
                        </div>

                        @if (!agent.IsActive)
                        {
                            <span class="agent-status agent-status-passive">
                                <span class="agent-status-dot"></span>
                                Pasif
                            </span>
                        }
                        else if (agent.IsVerified)
                        {
                            <span class="agent-status agent-status-active">
                                <span class="agent-status-dot"></span>
                                Aktif
                            </span>
                        }
                        else
                        {
                            <span class="agent-status agent-status-pending">
                                <span class="agent-status-dot"></span>
                                İncelemede
                            </span>
                        }

                    </div>

                    <p class="agent-about">
                        @(string.IsNullOrWhiteSpace(agent.About)
                            ? "Danışman hakkında henüz açıklama eklenmemiş."
                            : agent.About)
                    </p>

                    <div class="agent-details">

                        <div class="agent-detail-item">
                            <span class="agent-detail-icon">
                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true">
                                    <circle cx="12"
                                            cy="12"
                                            r="9">
                                    </circle>
                                    <path d="M12 7v5"></path>
                                    <path d="m12 12 3 2"></path>
                                </svg>
                            </span>

                            <div class="agent-detail-content">
                                <span>Deneyim</span>
                                <strong>@agent.ExperienceYear yıl</strong>
                            </div>
                        </div>

                        <div class="agent-detail-item">
                            <span class="agent-detail-icon">
                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true">
                                    <path d="M6 21V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v17"></path>
                                    <path d="M3 21h18"></path>
                                    <path d="M9 7h2M13 7h2"></path>
                                    <path d="M9 11h2M13 11h2"></path>
                                    <path d="M9 15h2M13 15h2"></path>
                                    <path d="M10 21v-3h4v3"></path>
                                </svg>
                            </span>

                            <div class="agent-detail-content">
                                <span>Ofis</span>

                                <strong title="@agent.OfficeName">
                                    @(string.IsNullOrWhiteSpace(agent.OfficeName)
                                        ? "Belirtilmedi"
                                        : agent.OfficeName)
                                </strong>
                            </div>
                        </div>

                        <div class="agent-detail-item">
                            <span class="agent-detail-icon">
                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true">
                                    <rect x="3"
                                          y="5"
                                          width="18"
                                          height="14"
                                          rx="2">
                                    </rect>
                                    <path d="m3 7 9 6 9-6"></path>
                                </svg>
                            </span>

                            <div class="agent-detail-content">
                                <span>E-posta</span>

                                <strong title="@agent.Email">
                                    @agent.Email
                                </strong>
                            </div>
                        </div>

                        <div class="agent-detail-item">
                            <span class="agent-detail-icon">
                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"></path>
                                    <path d="M14 2v6h6"></path>
                                    <path d="M8 13h8"></path>
                                    <path d="M8 17h5"></path>
                                </svg>
                            </span>

                            <div class="agent-detail-content">
                                <span>Lisans numarası</span>

                                <strong title="@agent.LicenseNumber">
                                    @(string.IsNullOrWhiteSpace(agent.LicenseNumber)
                                        ? "Belirtilmedi"
                                        : agent.LicenseNumber)
                                </strong>
                            </div>
                        </div>

                    </div>

                    <div class="agent-card-footer">

                        <a asp-area="Admin"
                           asp-controller="Agent"
                           asp-action="Update"
                           asp-route-id="@agent.AgentId"
                           class="agent-action agent-action-edit">

                            <svg viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="M12 20h9"></path>
                                <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
                            </svg>

                            Düzenle
                        </a>

                        <form asp-area="Admin"
                              asp-controller="Agent"
                              asp-action="Delete"
                              asp-route-id="@agent.AgentId"
                              method="post"
                              class="agent-delete-form">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="agent-action agent-action-delete"
                                    onclick="return confirm('Bu danışmanı silmek istediğinize emin misiniz?')">

                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true">
                                    <path d="M3 6h18"></path>
                                    <path d="M8 6V4h8v2"></path>
                                    <path d="m19 6-1 14H6L5 6"></path>
                                    <path d="M10 11v5M14 11v5"></path>
                                </svg>

                                Sil
                            </button>

                        </form>

                    </div>

                </article>
            }

        </div>
    }

</div>