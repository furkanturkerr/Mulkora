@model List<Mulkora.Dto.PropertyDtos.ResultPropertyDto>

@{
    Layout = "_AdminLayout";
}

<div class="page-heading">
    <div>
        <h1>İlan Yönetimi</h1>
        <p>Tüm ilanları durum, tip ve danışmana göre görüntüleyin ve yönetin.</p></div>
    <div class="page-heading-actions">
        <button class="panel-btn panel-btn-outline">Toplu işlem</button>
    </div>
</div>
<div class="toolbar">
    <div class="toolbar-group">
        <label style="position:relative">
            <svg class="icon" width="17" height="17" viewBox="0 0 24 24">
                <path d="M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14Zm5-2 4 4"/>
            </svg>
            <input class="panel-input" data-filter-text="[data-property-row]" type="search"
                   placeholder="İlan adı veya konum ara" style="padding-left:38px"></label>
        <select
            class="panel-select">
            <option>Tüm durumlar</option>
            <option>Yayında</option>
            <option>Onay bekliyor</option>
            <option>Pasif</option>
        </select>
        <select class="panel-select">
            <option>Tüm tipler</option>
            <option>Satılık</option>
            <option>Kiralık</option>
        </select></div>
    <div class="toolbar-group">
        <button class="panel-btn panel-btn-outline">
            <svg class="icon" width="16" height="16" viewBox="0 0 24 24">
                <path d="M4 5h16M7 12h10M10 19h4"/>
            </svg>
            Filtreler
        </button>
        <button class="panel-btn panel-btn-outline">Dışa aktar</button>
    </div>
</div>

<section class="panel-card">
    <div class="panel-table-wrap">
        <table class="panel-table">
            <thead>
            <tr>
                <th>İlan</th>
                <th>Danışman</th>
                <th>Fiyat</th>
                <th>Durum</th>
                <th>Eklenme</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            
            @foreach (var item in Model)
            {
                <tr data-property-row>
                    <td>
                        <div class="table-property">
                            <img src="~/Mulkora_Full_Theme_With_Panels/assets/images/properties/property-01.svg"
                                 alt="">
                            <div><strong>@item.Title</strong><span>@item.District, @item.City</span></div>
                        </div>
                    </td>
                    <td>@item.AgentId</td>
                    <td><strong>₺@item.Price.ToString("N")</strong></td>
                    
                    @if (item.Status == 1)
                    {
                        <td><span class="status status-info">Taslak</span></td>
                    }
                    else if (item.Status == 2)
                    {
                        <td><span class="status status-warning">Onay Bekliyor</span></td>
                    }
                    else if (item.Status == 3)
                    {
                        <td><span class="status status-success">Yayında</span></td>
                    }
                    else if (item.Status == 4)
                    {
                        <td><span class="status status-danger">Reddedildi</span></td>
                    }
                    else if (item.Status == 5)
                    {
                        <td><span class="status status-secondary">Pasif</span></td>
                    }
                    else if (item.Status == 6)
                    {
                        <td><span class="status status-success">Satıldı</span></td>
                    }
                    else if (item.Status == 7)
                    {
                        <td><span class="status status-success">Kiralandı</span></td>
                    }
                    
                    <td>@item.CreatedDate.ToString("dd MMM yyyy")</td>
                    <td>
                        <div class="table-actions">
                            <button class="table-action" title="Görüntüle">
                                <svg class="icon" width="16" height="16" viewBox="0 0 24 24">
                                    <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Zm10 2.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"/>
                                </svg>
                            </button>

                            <a href="~/Admin/Property/Update/@item.PropertyId" class="table-action" title="Düzenle">
                                <svg class="icon" width="16" height="16" viewBox="0 0 24 24">
                                    <path d="m4 20 4.5-1L19 8.5 15.5 5 5 15.5 4 20ZM13.5 7l3.5 3.5"/>
                                </svg>
                            </a>

                            <button class="table-action" title="Sil">
                                <svg class="icon" width="16" height="16" viewBox="0 0 24 24">
                                    <path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 10v6M14 10v6"/>
                                </svg>
                            </button>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
            <div class="pagination"><span>1.284 ilandan 1–8 arası gösteriliyor</span>
                <div class="pagination-pages">
                    <button>‹</button>
                    <button class="active">1</button>
                    <button>2</button>
                    <button>3</button>
                    <button>…</button>
                    <button>161</button>
                    <button>›</button>
                </div>
            </div>
