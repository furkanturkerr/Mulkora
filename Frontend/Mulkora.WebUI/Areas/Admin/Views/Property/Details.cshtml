@model Mulkora.WebUI.Areas.Admin.Models.PropertyDetailsViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "İlan İnceleme";

    var property = Model.Property;

    var statusText = property.Status switch
    {
        1 => "Taslak",
        2 => "Onay Bekliyor",
        3 => "Yayında",
        4 => "Reddedildi",
        5 => "Pasif",
        6 => "Satıldı",
        7 => "Kiralandı",
        _ => "Bilinmiyor"
    };

    var statusClass = property.Status switch
    {
        1 => "details-status-draft",
        2 => "details-status-pending",
        3 => "details-status-published",
        4 => "details-status-rejected",
        5 => "details-status-passive",
        6 => "details-status-sold",
        7 => "details-status-rented",
        _ => "details-status-passive"
    };

    var listingTypeText = property.ListingType == 1 ? "Satılık" : "Kiralık";
}

<link rel="stylesheet" href="~/css/admin/property-details.css" asp-append-version="true">

<div class="property-details-page">

    <header class="details-hero">

        <div class="details-hero-content">

            <a asp-area="Admin" asp-controller="Property" asp-action="PropertyList" class="details-back-link">
                <svg class="details-svg" width="15" height="15" viewBox="0 0 24 24">
                    <path d="m15 18-6-6 6-6"/>
                </svg>
                İlan yönetimine dön
            </a>

            <span class="details-hero-eyebrow">İlan inceleme · #@property.PropertyId</span>

            <h1>@property.Title</h1>

            <div class="details-hero-location">
                <svg class="details-svg" width="14" height="14" viewBox="0 0 24 24">
                    <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/>
                    <circle cx="12" cy="10" r="2.5"/>
                </svg>

                <span>@property.District, @property.City</span>
            </div>

        </div>

        <div class="details-hero-summary">
            <div class="details-hero-price">₺@property.Price.ToString("N0")</div>

            <div class="details-hero-summary-bottom">
                <span class="details-listing-type">@listingTypeText</span>
                <span class="details-status @statusClass">@statusText</span>
            </div>
        </div>

    </header>

    <div class="details-layout">

        <main class="details-main">

            <section class="details-card">

                <div class="details-card-header">

                    <div class="details-card-heading">
                        <span class="details-card-icon">
                            <svg class="details-svg" width="18" height="18" viewBox="0 0 24 24">
                                <rect x="3" y="4" width="18" height="16" rx="2"/>
                                <circle cx="8.5" cy="9" r="1.5"/>
                                <path d="m21 15-5-5L5 20"/>
                            </svg>
                        </span>

                        <div>
                            <h2>İlan Görselleri</h2>
                            <p>İlana ait yüklenen bütün görseller.</p>
                        </div>
                    </div>

                    <span class="details-card-count">@Model.PropertyImages.Count görsel</span>

                </div>

                <div class="details-card-body">

                    @if (Model.PropertyImages != null && Model.PropertyImages.Any())
                    {
                        <div class="details-gallery">

                            @foreach (var image in Model.PropertyImages.OrderBy(x => x.DisplayOrder))
                            {
                                <div class="details-gallery-item">
                                    <img src="@(
                                              string.IsNullOrWhiteSpace(image.ImageUrl)
                                                  ? Url.Content("~/Mulkora_Full_Theme_With_Panels/assets/images/properties/property-01.svg")
                                                  : image.ImageUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                                                      ? image.ImageUrl
                                                      : $"http://localhost:5214{image.ImageUrl}"
                                              )"
                                         alt="@property.Title">                                    <span class="details-image-order">@image.DisplayOrder</span>
                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="details-gallery-empty">
                            Bu ilana ait yüklenmiş görsel bulunmuyor.
                        </div>
                    }

                </div>

            </section>

            <section class="details-card">

                <div class="details-card-header">

                    <div class="details-card-heading">
                        <span class="details-card-icon">
                            <svg class="details-svg" width="18" height="18" viewBox="0 0 24 24">
                                <path d="M4 4h16v16H4zM8 9h8M8 13h8M8 17h5"/>
                            </svg>
                        </span>

                        <div>
                            <h2>İlan Açıklaması</h2>
                            <p>Danışman tarafından girilen ilan açıklaması ve adresi.</p>
                        </div>
                    </div>

                </div>

                <div class="details-card-body">
                    <p class="details-description">@property.Description</p>

                    <div class="details-address">
                        <svg class="details-svg" width="17" height="17" viewBox="0 0 24 24">
                            <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/>
                            <circle cx="12" cy="10" r="2.5"/>
                        </svg>

                        <span>@property.Address</span>
                    </div>
                </div>

            </section>

            <section class="details-card">

                <div class="details-card-header">

                    <div class="details-card-heading">
                        <span class="details-card-icon">
                            <svg class="details-svg" width="18" height="18" viewBox="0 0 24 24">
                                <path d="M3 21V9l9-6 9 6v12M8 21v-7h8v7M3 10h18"/>
                            </svg>
                        </span>

                        <div>
                            <h2>Mülk Detayları</h2>
                            <p>İlanın oda, metrekare, bina ve kat bilgileri.</p>
                        </div>
                    </div>

                </div>

                <div class="details-card-body">

                    <div class="details-metric-grid">

                        <div class="details-metric">
                            <span>Oda sayısı</span>
                            <strong>@property.RoomCount</strong>
                        </div>

                        <div class="details-metric">
                            <span>Salon sayısı</span>
                            <strong>@property.LivingRoomCount</strong>
                        </div>

                        <div class="details-metric">
                            <span>Banyo sayısı</span>
                            <strong>@property.BathroomCount</strong>
                        </div>

                        <div class="details-metric">
                            <span>Brüt alan</span>
                            <strong>@property.GrossSquareMeter m²</strong>
                        </div>

                        <div class="details-metric">
                            <span>Net alan</span>
                            <strong>@property.NetSquareMeter m²</strong>
                        </div>

                        <div class="details-metric">
                            <span>Bina yaşı</span>
                            <strong>@property.BuildingAge</strong>
                        </div>

                        <div class="details-metric">
                            <span>Bulunduğu kat</span>
                            <strong>@property.FloorNumber</strong>
                        </div>

                        <div class="details-metric">
                            <span>Toplam kat</span>
                            <strong>@property.TotalFloor</strong>
                        </div>

                    </div>

                    <div class="details-boolean-grid">

                        <div class="details-boolean @(!property.IsFurnished ? "false" : null)">
                            <span class="details-boolean-icon">✓</span>
                            <span>@(property.IsFurnished ? "Mülk eşyalı" : "Mülk eşyasız")</span>
                        </div>

                        <div class="details-boolean @(!property.IsFeatured ? "false" : null)">
                            <span class="details-boolean-icon">✓</span>
                            <span>@(property.IsFeatured ? "Öne çıkan ilan" : "Öne çıkarılmamış")</span>
                        </div>

                    </div>

                </div>

            </section>

            <section class="details-card">

                <div class="details-card-header">

                    <div class="details-card-heading">
                        <span class="details-card-icon">
                            <svg class="details-svg" width="18" height="18" viewBox="0 0 24 24">
                                <path d="m12 3 2.4 4.9L20 8.7l-4 3.9.9 5.5-4.9-2.6-4.9 2.6.9-5.5-4-3.9 5.6-.8L12 3Z"/>
                            </svg>
                        </span>

                        <div>
                            <h2>İlan Özellikleri</h2>
                            <p>Danışman tarafından seçilen ilan özellikleri.</p>
                        </div>
                    </div>

                    <span class="details-card-count">@(property.Features?.Count ?? 0) özellik</span>

                </div>

                <div class="details-card-body">

                    @if (property.Features != null && property.Features.Any())
                    {
                        <div class="details-feature-list">

                            @foreach (var feature in property.Features)
                            {
                                <span class="details-feature">@feature.Name</span>
                            }

                        </div>
                    }
                    else
                    {
                        <p class="details-feature-empty">Bu ilan için seçilmiş özellik bulunmuyor.</p>
                    }

                </div>

            </section>

        </main>

        <aside class="details-sidebar">

            <section class="details-side-card">

                <h3>Kayıt Bilgileri</h3>

                <div class="details-info-list">

                    <div class="details-info-row">
                        <span>İlan numarası</span>
                        <strong>#@property.PropertyId</strong>
                    </div>

                    <div class="details-info-row">
                        <span>Danışman</span>
                        <strong>#@property.AgentId</strong>
                    </div>

                    <div class="details-info-row">
                        <span>Kategori</span>
                        <strong>#@property.CategoryId</strong>
                    </div>

                    <div class="details-info-row">
                        <span>İlan türü</span>
                        <strong>@listingTypeText</strong>
                    </div>

                    <div class="details-info-row">
                        <span>Durum</span>
                        <strong>@statusText</strong>
                    </div>

                    <div class="details-info-row">
                        <span>Şehir</span>
                        <strong>@property.City</strong>
                    </div>

                    <div class="details-info-row">
                        <span>İlçe</span>
                        <strong>@property.District</strong>
                    </div>

                    <div class="details-info-row">
                        <span>Oluşturulma</span>
                        <strong>@property.CreatedDate.ToString("dd MMM yyyy")</strong>
                    </div>

                    <div class="details-info-row">
                        <span>Son güncelleme</span>
                        <strong>@(property.UpdatedDate.ToString("dd MMM yyyy") ?? "Güncellenmedi")</strong>
                    </div>

                </div>

            </section>

            <section class="details-side-card details-decision-card @(property.Status == 2 ? "pending" : null)">

                <h3>Yayın Kararı</h3>

                @if (property.Status == 2)
                {
                    <p class="details-decision-notice">İlan danışman tarafından onaya gönderildi. Bilgileri ve görselleri kontrol ederek yayın kararını verin.</p>
                    
                    @if (Model.Property.AiIsApproved == false)
                    {
                        <div class="ai-warning">
                            <svg width="19"
                                 height="19"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2">
                                <path d="M12 3 2 21h20L12 3Z"></path>
                                <path d="M12 9v5"></path>
                                <path d="M12 18h.01"></path>
                            </svg>

                            <div>
                                <strong>AI içerik uyarısı</strong>
                                <span>
                                    İlan içeriğinde anlamsız veya uygun olmayan bilgiler
                                    bulunabilir. Onaylamadan önce ilanı dikkatlice kontrol edin.
                                </span>
                            </div>
                        </div>
                    }
                    else if (Model.Property.AiIsApproved == true)
                    {
                        <div class="ai-success">
                            <svg width="19"
                                 height="19"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2">
                                <path d="m5 12 4 4L19 6"></path>
                            </svg>

                            <div>
                                <strong>AI ön kontrolü tamamlandı</strong>
                                <span>İlan içeriğinde belirgin bir sorun bulunamadı.</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="ai-unavailable">
                            AI içerik kontrolü şu anda yapılamadı.
                        </div>
                    }

                    <div class="details-decision-actions">

                        <form asp-area="Admin" asp-controller="Property" asp-action="Approve" asp-route-id="@property.PropertyId" method="post">
                            @Html.AntiForgeryToken()

                            <button type="submit" class="details-decision-button details-approve-button">
                                <svg class="details-svg" width="15" height="15" viewBox="0 0 24 24">
                                    <path d="m5 12 4 4L19 6"/>
                                </svg>
                                İlanı Onayla
                            </button>
                        </form>

                        <form asp-area="Admin" asp-controller="Property" asp-action="Reject" asp-route-id="@property.PropertyId" method="post">
                            @Html.AntiForgeryToken()

                            <button type="submit" class="details-decision-button details-reject-button" onclick="return confirm('Bu ilanı reddetmek istediğinize emin misiniz?')">
                                <svg class="details-svg" width="15" height="15" viewBox="0 0 24 24">
                                    <path d="M6 6l12 12M18 6 6 18"/>
                                </svg>
                                İlanı Reddet
                            </button>
                        </form>

                    </div>
                }
                else
                {
                    <div class="details-decision-result">Bu ilan şu anda <strong>@statusText</strong> durumunda olduğu için onay işlemi yapılamaz.</div>
                }

            </section>

        </aside>

    </div>

</div>