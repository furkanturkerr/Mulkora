@model Mulkora.Dto.RoleDtos.CreateRoleDto

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Rol Ekle";
}

<style>
    .role-form-page {
        padding: 32px;
        max-width: 700px;
    }

    .role-form-header {
        margin-bottom: 24px;
    }

    .role-form-header h1 {
        margin: 0;
        font-size: 24px;
        font-weight: 700;
        color: #111827;
    }

    .role-form-header p {
        margin: 6px 0 0;
        font-size: 14px;
        color: #6b7280;
    }

    .role-form-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 24px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .form-group label {
        font-size: 14px;
        font-weight: 600;
        color: #374151;
    }

    .form-group input {
        width: 100%;
        height: 44px;
        padding: 0 14px;
        border: 1px solid #d1d5db;
        border-radius: 9px;
        font-size: 14px;
        outline: none;
        box-sizing: border-box;
    }

    .form-group input:focus {
        border-color: #9ca3af;
    }

    .form-actions {
        display: flex;
        gap: 10px;
        margin-top: 24px;
    }

    .btn {
        padding: 10px 18px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        border: none;
    }

    .btn-primary {
        background: #111827;
        color: #fff;
    }

    .btn-primary:hover {
        background: #1f2937;
    }

    .btn-secondary {
        background: #f3f4f6;
        color: #374151;
    }

    .validation {
        font-size: 13px;
        color: #dc2626;
    }
</style>

<div class="role-form-page">

    <div class="role-form-header">
        <h1>Yeni Rol Ekle</h1>
        <p>Sisteme yeni bir kullanıcı rolü oluşturun.</p>
    </div>

    <div class="role-form-card">

        <form method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="Name">Rol Adı</label>
                <input asp-for="Name" placeholder="Örn: Admin" />
                <span asp-validation-for="Name" class="validation"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Rol Ekle</button>
                <a asp-action="RoleList" class="btn btn-secondary">İptal</a>
            </div>
        </form>

    </div>

</div>