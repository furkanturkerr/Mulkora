@model List<Mulkora.Dto.RoleDtos.ResultRoleDto>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Rol Yönetimi";
}

<style>
    .role-page {
        padding: 32px;
    }

    .role-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
    }

    .role-header h1 {
        margin: 0;
        font-size: 24px;
        font-weight: 700;
        color: #111827;
    }

    .role-header p {
        margin: 6px 0 0;
        font-size: 14px;
        color: #6b7280;
    }

    .role-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        overflow: hidden;
    }

    .role-table {
        width: 100%;
        border-collapse: collapse;
    }

    .role-table th {
        padding: 14px 18px;
        text-align: left;
        font-size: 12px;
        font-weight: 600;
        color: #6b7280;
        background: #f9fafb;
        border-bottom: 1px solid #e5e7eb;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .role-table td {
        padding: 16px 18px;
        font-size: 14px;
        color: #374151;
        border-bottom: 1px solid #f1f1f1;
    }

    .role-table tbody tr:last-child td {
        border-bottom: none;
    }

    .role-table tbody tr:hover {
        background: #fafafa;
    }

    .role-name {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 600;
        color: #111827;
    }

    .role-icon {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        background: #f3f4f6;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .role-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .role-action {
        width: 34px;
        height: 34px;
        border: 1px solid #e5e7eb;
        background: #fff;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: #6b7280;
        transition: .2s;
    }

    .role-action:hover {
        background: #f3f4f6;
        color: #111827;
    }

    .role-action.delete:hover {
        background: #fef2f2;
        border-color: #fecaca;
        color: #dc2626;
    }

    .empty-role {
        padding: 50px 20px;
        text-align: center;
        color: #9ca3af;
    }

    @@media (max-width: 768px) {
        .role-page {
            padding: 20px;
        }

        .role-id {
            display: none;
        }
    }

    .add-role-btn {
        padding: 10px 16px;
        background: #111827;
        color: #fff;
        border-radius: 9px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        transition: .2s;
    }

    .add-role-btn:hover {
        background: #1f2937;
        color: #fff;
    }
</style>

<div class="role-page">

    <div class="role-header">
        <div>
            <h1>Rol Yönetimi</h1>
            <p>Sistemde tanımlı kullanıcı rollerini görüntüleyin ve yönetin.</p>
        </div>

        <a asp-area="Admin" asp-controller="Role" asp-action="Create" class="add-role-btn">
            + Yeni Rol Ekle
        </a>
    </div>

    <div class="role-card">

        @if (Model != null && Model.Any())
        {
            <table class="role-table">
                <thead>
                <tr>
                    <th>Rol</th>
                    <th class="role-id">Id</th>
                    <th style="width: 120px;">İşlemler</th>
                </tr>
                </thead>

                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="role-name">
                                <div class="role-icon">
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                        <path d="M12 3 4 7v5c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V7l-8-4Z"/>
                                        <path d="M9 12l2 2 4-4"/>
                                    </svg>
                                </div>

                                @item.Name
                            </div>
                        </td>

                        <td class="role-id">
                            @item.Id
                        </td>

                        <td>
                            <div class="role-actions">

                                <a asp-area="Admin" asp-controller="Role" asp-action="Update" asp-route-id="@item.Id" class="role-action" title="Düzenle">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                        <path d="m4 20 4.5-1L19 8.5 15.5 5 5 15.5 4 20Z"/>
                                        <path d="m13.5 7 3.5 3.5"/>
                                    </svg>
                                </a>
                                
                                <form asp-area="Admin"
                                      asp-controller="Role"
                                      asp-action="Delete"
                                      asp-route-id="@item.Id"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="role-action delete"
                                            title="Sil"
                                            onclick="return confirm('Bu rolü silmek istediğine emin misiniz?')">

                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                            <path d="M3 6h18"/>
                                            <path d="M8 6V4h8v2"/>
                                            <path d="m19 6-1 14H6L5 6"/>
                                            <path d="M10 10v6M14 10v6"/>
                                        </svg>

                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-role">
                Henüz herhangi bir rol bulunmuyor.
            </div>
        }

    </div>

</div>