@model List<Mulkora.Dto.RoleDtos.ResultRoleDto>

@{
Layout = "_AdminLayout";
ViewData["Title"] = "Rol Yönetimi";
}

<link rel="stylesheet"
      href="~/css/admin/role.css"
      asp-append-version="true">

<div class="roles-page">

    <div class="roles-heading">

        <div>
            <h1>Rol Yönetimi</h1>

            <p>
                Sistemde tanımlı kullanıcı rollerini
                görüntüleyin ve yönetin.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Role"
           asp-action="Create"
           class="role-add-button">

            <svg viewBox="0 0 24 24"
                 aria-hidden="true">
                <path d="M12 5v14"></path>
                <path d="M5 12h14"></path>
            </svg>

            Yeni Rol Ekle
        </a>

    </div>

    <section class="roles-card">

        <div class="roles-card-heading">

            <div>
                <strong>Rol listesi</strong>

                <span>
                    Sistemde toplam @(Model?.Count ?? 0) rol tanımlı
                </span>
            </div>

        </div>

        @if (Model != null && Model.Any())
        {
        <div class="roles-table-wrapper">

            <table class="roles-table">

                <thead>
                <tr>
                    <th>Rol</th>
                    <th class="role-id-column">Rol kimliği</th>
                    <th class="role-actions-heading">İşlemler</th>
                </tr>
                </thead>

                <tbody>

                @foreach (var item in Model)
                {
                <tr>

                    <td>
                        <div class="role-info">

                            <div class="role-icon">
                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true">
                                    <path d="M12 3 4 7v5c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V7l-8-4Z"></path>
                                    <path d="m9 12 2 2 4-4"></path>
                                </svg>
                            </div>

                            <div class="role-identity">
                                <strong>@item.Name</strong>

                                <span>
                                            Sistem rolü
                                        </span>
                            </div>

                        </div>
                    </td>

                    <td class="role-id-column">
                                <span class="role-id-value">
                                    @item.Id
                                </span>
                    </td>

                    <td>
                        <div class="role-actions">

                            <a asp-area="Admin"
                               asp-controller="Role"
                               asp-action="Update"
                               asp-route-id="@item.Id"
                               class="role-action role-action-edit"
                               title="Rolü düzenle">

                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true">
                                    <path d="m4 20 4.5-1L19 8.5 15.5 5 5 15.5 4 20Z"></path>
                                    <path d="m13.5 7 3.5 3.5"></path>
                                </svg>

                            </a>

                            <form asp-area="Admin"
                                  asp-controller="Role"
                                  asp-action="Delete"
                                  asp-route-id="@item.Id"
                                  method="post"
                                  class="role-delete-form">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="role-action role-action-delete"
                                        title="Rolü sil"
                                        onclick="return confirm('Bu rolü silmek istediğinize emin misiniz?')">

                                    <svg viewBox="0 0 24 24"
                                         aria-hidden="true">
                                        <path d="M3 6h18"></path>
                                        <path d="M8 6V4h8v2"></path>
                                        <path d="m19 6-1 14H6L5 6"></path>
                                        <path d="M10 10v6M14 10v6"></path>
                                    </svg>

                                </button>

                            </form>

                        </div>
                    </td>

                </tr>
                }

                </tbody>
            </table>

        </div>
        }
        else
        {
        <div class="roles-empty">

            <div class="roles-empty-icon">
                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M12 3 4 7v5c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V7l-8-4Z"></path>
                    <path d="M12 8v8"></path>
                    <path d="M8 12h8"></path>
                </svg>
            </div>

            <h2>Henüz rol bulunmuyor</h2>

            <p>
                Kullanıcılara atanabilecek ilk rolü oluşturun.
            </p>

            <a asp-area="Admin"
               asp-controller="Role"
               asp-action="Create"
               class="role-add-button">
                Yeni Rol Ekle
            </a>

        </div>
        }

    </section>

</div>