@model Mulkora.WebUI.Areas.Agent.Models.CreatePropertyViewModel

@{
    Layout = "_AgentLayout";
    ViewData["Title"] = "Yeni İlan Ekle";
}

<link rel="stylesheet" href="~/css/property-editor.css" asp-append-version="true">

<div class="property-editor">

    <header class="property-editor-header">

        <div class="property-header-content">

            <a asp-area="Agent" asp-controller="Property" asp-action="PropertyList" class="property-back-link">
                <svg class="property-svg" width="15" height="15" viewBox="0 0 24 24">
                    <path d="m15 18-6-6 6-6"/>
                </svg>
                İlanlarıma dön
            </a>

            <div class="property-header-title">
                <h1>Yeni İlan Oluştur</h1>
                <span class="property-header-badge">Yeni taslak</span>
            </div>

            <p class="property-header-description">İlan bilgilerini eksiksiz doldurun. Sağdaki önizleme alanından ilanınızın müşterilere nasıl görüneceğini takip edin.</p>

        </div>

        <div class="property-header-meta">
            <div class="property-header-meta-item">
                <small>Başlangıç durumu</small>
                <strong>Taslak</strong>
            </div>

            <div class="property-header-meta-item">
                <small>Sonraki adım</small>
                <strong>Onaya gönder</strong>
            </div>
        </div>

    </header>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="property-error-alert">@TempData["ErrorMessage"]</div>
    }

    <form asp-area="Agent" asp-controller="Property" asp-action="Create" method="post" enctype="multipart/form-data" class="property-editor-form" data-property-editor data-has-existing-image="false">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="property-validation-summary"></div>

        <div class="property-editor-workspace">

            <nav class="property-section-navigation">

                <div class="property-navigation-title">İlan bölümleri</div>

                <div class="property-navigation-list">
                    <a href="#basic-section" class="property-navigation-link active" data-navigation-link="basic-section">
                        <span class="property-navigation-number">01</span>
                        Temel bilgiler
                    </a>

                    <a href="#location-section" class="property-navigation-link" data-navigation-link="location-section">
                        <span class="property-navigation-number">02</span>
                        Konum
                    </a>

                    <a href="#details-section" class="property-navigation-link" data-navigation-link="details-section">
                        <span class="property-navigation-number">03</span>
                        Mülk detayları
                    </a>

                    <a href="#images-section" class="property-navigation-link" data-navigation-link="images-section">
                        <span class="property-navigation-number">04</span>
                        Görseller
                    </a>

                    <a href="#features-section" class="property-navigation-link" data-navigation-link="features-section">
                        <span class="property-navigation-number">05</span>
                        Özellikler
                    </a>
                </div>

                <div class="property-navigation-note">İlan kaydedildikten sonra taslak durumunda oluşturulur. Hazır olduğunda onaya gönderebilirsiniz.</div>

            </nav>

            <main class="property-editor-content">

                <section id="basic-section" class="property-form-section" data-editor-section>

                    <div class="property-section-header">
                        <div class="property-section-heading">
                            <span class="property-section-icon">
                                <svg class="property-svg" width="18" height="18" viewBox="0 0 24 24">
                                    <path d="M4 4h16v16H4zM8 9h8M8 13h8M8 17h5"/>
                                </svg>
                            </span>

                            <div>
                                <h2>Temel Bilgiler</h2>
                                <p>İlanın müşteriler tarafından görülecek ana bilgileri.</p>
                            </div>
                        </div>

                        <span class="property-section-label">Bölüm 01</span>
                    </div>

                    <div class="property-section-body">

                        <div class="property-fields property-fields-three">

                            <div class="property-field property-field-full">
                                <label asp-for="Property.Title" class="property-label">İlan Başlığı</label>
                                <input asp-for="Property.Title" class="property-control" placeholder="Örn: Boğaz manzaralı modern daire" data-preview-source="title">
                                <span asp-validation-for="Property.Title" class="property-validation-message"></span>
                            </div>

                            <div class="property-field property-field-full">
                                <label asp-for="Property.Description" class="property-label">İlan Açıklaması</label>
                                <textarea asp-for="Property.Description" class="property-control" placeholder="Mülkün öne çıkan özelliklerini, konumunu ve avantajlarını açıklayın..." data-preview-source="description"></textarea>
                                <span asp-validation-for="Property.Description" class="property-validation-message"></span>
                            </div>

                            <div class="property-field">
                                <label asp-for="Property.Price" class="property-label">Fiyat</label>

                                <div class="property-price-control">
                                    <span>₺</span>
                                    <input asp-for="Property.Price" type="number" step="0.01" min="0" class="property-control" data-preview-source="price">
                                </div>

                                <span asp-validation-for="Property.Price" class="property-validation-message"></span>
                            </div>

                            <div class="property-field">
                                <label asp-for="Property.ListingType" class="property-label">İlan Türü</label>

                                <select asp-for="Property.ListingType" class="property-control" data-preview-source="listingType">
                                    <option value="">İlan türü seçin</option>
                                    <option value="1">Satılık</option>
                                    <option value="2">Kiralık</option>
                                </select>

                                <span asp-validation-for="Property.ListingType" class="property-validation-message"></span>
                            </div>

                            <div class="property-field">
                                <label asp-for="Property.CategoryId" class="property-label">Kategori</label>

                                <select asp-for="Property.CategoryId" asp-items="@ViewBag.CategoryList" class="property-control" data-preview-source="category">
                                    <option value="">Kategori seçin</option>
                                </select>

                                <span asp-validation-for="Property.CategoryId" class="property-validation-message"></span>
                            </div>

                        </div>

                    </div>

                </section>

                <section id="location-section" class="property-form-section" data-editor-section>

                    <div class="property-section-header">
                        <div class="property-section-heading">
                            <span class="property-section-icon">
                                <svg class="property-svg" width="18" height="18" viewBox="0 0 24 24">
                                    <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/>
                                    <circle cx="12" cy="10" r="2.5"/>
                                </svg>
                            </span>

                            <div>
                                <h2>Konum Bilgileri</h2>
                                <p>Mülkün bulunduğu şehir, ilçe ve açık adres.</p>
                            </div>
                        </div>

                        <span class="property-section-label">Bölüm 02</span>
                    </div>

                    <div class="property-section-body">

                        <div class="property-fields">

                            <div class="property-field">
                                <label asp-for="Property.City" class="property-label">Şehir</label>
                                <input asp-for="Property.City" class="property-control" placeholder="Örn: İstanbul" data-preview-source="city">
                                <span asp-validation-for="Property.City" class="property-validation-message"></span>
                            </div>

                            <div class="property-field">
                                <label asp-for="Property.District" class="property-label">İlçe</label>
                                <input asp-for="Property.District" class="property-control" placeholder="Örn: Beşiktaş" data-preview-source="district">
                                <span asp-validation-for="Property.District" class="property-validation-message"></span>
                            </div>

                            <div class="property-field property-field-full">
                                <label asp-for="Property.Address" class="property-label">Açık Adres</label>
                                <input asp-for="Property.Address" class="property-control" placeholder="Mahalle, cadde, sokak ve bina bilgisi" data-preview-source="address">
                                <span asp-validation-for="Property.Address" class="property-validation-message"></span>
                            </div>

                        </div>

                    </div>

                </section>

                <section id="details-section" class="property-form-section" data-editor-section>

                    <div class="property-section-header">
                        <div class="property-section-heading">
                            <span class="property-section-icon">
                                <svg class="property-svg" width="18" height="18" viewBox="0 0 24 24">
                                    <path d="M3 21V9l9-6 9 6v12M8 21v-7h8v7M3 10h18"/>
                                </svg>
                            </span>

                            <div>
                                <h2>Mülk Detayları</h2>
                                <p>Oda, metrekare, bina yaşı ve kat bilgileri.</p>
                            </div>
                        </div>

                        <span class="property-section-label">Bölüm 03</span>
                    </div>

                    <div class="property-section-body">

                        <div class="property-fields property-fields-three">

                            <div class="property-field">
                                <label asp-for="Property.RoomCount" class="property-label">Oda Sayısı</label>
                                <input asp-for="Property.RoomCount" type="number" min="0" class="property-control" data-preview-source="room">
                                <span asp-validation-for="Property.RoomCount" class="property-validation-message"></span>
                            </div>

                            <div class="property-field">
                                <label asp-for="Property.LivingRoomCount" class="property-label">Salon Sayısı</label>
                                <input asp-for="Property.LivingRoomCount" type="number" min="0" class="property-control">
                                <span asp-validation-for="Property.LivingRoomCount" class="property-validation-message"></span>
                            </div>

                            <div class="property-field">
                                <label asp-for="Property.BathroomCount" class="property-label">Banyo Sayısı</label>
                                <input asp-for="Property.BathroomCount" type="number" min="0" class="property-control" data-preview-source="bathroom">
                                <span asp-validation-for="Property.BathroomCount" class="property-validation-message"></span>
                            </div>

                            <div class="property-field">
                                <label asp-for="Property.GrossSquareMeter" class="property-label">Brüt m²</label>
                                <input asp-for="Property.GrossSquareMeter" type="number" min="0" class="property-control" data-preview-source="gross">
                                <span asp-validation-for="Property.GrossSquareMeter" class="property-validation-message"></span>
                            </div>

                            <div class="property-field">
                                <label asp-for="Property.NetSquareMeter" class="property-label">Net m²</label>
                                <input asp-for="Property.NetSquareMeter" type="number" min="0" class="property-control">
                                <span asp-validation-for="Property.NetSquareMeter" class="property-validation-message"></span>
                            </div>

                            <div class="property-field">
                                <label asp-for="Property.BuildingAge" class="property-label">Bina Yaşı</label>
                                <input asp-for="Property.BuildingAge" type="number" min="0" class="property-control">
                                <span asp-validation-for="Property.BuildingAge" class="property-validation-message"></span>
                            </div>

                            <div class="property-field">
                                <label asp-for="Property.FloorNumber" class="property-label">Bulunduğu Kat</label>
                                <input asp-for="Property.FloorNumber" type="number" class="property-control">
                                <span asp-validation-for="Property.FloorNumber" class="property-validation-message"></span>
                            </div>

                            <div class="property-field">
                                <label asp-for="Property.TotalFloor" class="property-label">Toplam Kat</label>
                                <input asp-for="Property.TotalFloor" type="number" min="1" class="property-control">
                                <span asp-validation-for="Property.TotalFloor" class="property-validation-message"></span>
                            </div>

                            <div class="property-field">
                                <span class="property-label">Eşya Durumu</span>

                                <label class="property-furnished">
                                    <input asp-for="Property.IsFurnished">

                                    <span>
                                        <strong>Eşyalı</strong>
                                        <small>Mülk eşyalı olarak sunuluyor</small>
                                    </span>
                                </label>

                                <span asp-validation-for="Property.IsFurnished" class="property-validation-message"></span>
                            </div>

                        </div>

                    </div>

                </section>

                <section id="images-section" class="property-form-section" data-editor-section>

                    <div class="property-section-header">
                        <div class="property-section-heading">
                            <span class="property-section-icon">
                                <svg class="property-svg" width="18" height="18" viewBox="0 0 24 24">
                                    <rect x="3" y="4" width="18" height="16" rx="2"/>
                                    <circle cx="8.5" cy="9" r="1.5"/>
                                    <path d="m21 15-5-5L5 20"/>
                                </svg>
                            </span>

                            <div>
                                <h2>İlan Görselleri</h2>
                                <p>Birden fazla ilan görseli seçebilirsiniz.</p>
                            </div>
                        </div>

                        <span class="property-section-label">Bölüm 04</span>
                    </div>

                    <div class="property-section-body">

                        <div class="property-upload-area">
                            <span class="property-upload-icon">
                                <svg class="property-svg" width="22" height="22" viewBox="0 0 24 24">
                                    <path d="M12 16V4M7 9l5-5 5 5M4 15v5h16v-5"/>
                                </svg>
                            </span>

                            <strong>Görselleri yükleyin</strong>
                            <p>İlk seçilen görsel önizlemede ve ilan listesinde kullanılacaktır.</p>

                            <input asp-for="Images" type="file" multiple accept=".jpg,.jpeg,.png,.webp" class="property-file-input" data-preview-source="images">
                        </div>

                        <span asp-validation-for="Images" class="property-validation-message"></span>

                    </div>

                </section>

                <section id="features-section" class="property-form-section" data-editor-section>

                    <div class="property-section-header">
                        <div class="property-section-heading">
                            <span class="property-section-icon">
                                <svg class="property-svg" width="18" height="18" viewBox="0 0 24 24">
                                    <path d="m12 3 2.4 4.9L20 8.7l-4 3.9.9 5.5-4.9-2.6-4.9 2.6.9-5.5-4-3.9 5.6-.8L12 3Z"/>
                                </svg>
                            </span>

                            <div>
                                <h2>İlan Özellikleri</h2>
                                <p>Mülkte bulunan ek özellikleri seçin.</p>
                            </div>
                        </div>

                        <span class="property-section-label">Bölüm 05</span>
                    </div>

                    <div class="property-section-body">

                        @if (Model.Features != null && Model.Features.Any())
                        {
                            <div class="property-feature-grid">

                                @foreach (var feature in Model.Features)
                                {
                                    <label class="property-feature-option" for="feature-@feature.FeatureId">
                                        <input type="checkbox" id="feature-@feature.FeatureId" name="Property.FeatureIds" value="@feature.FeatureId" checked="@(feature.IsSelected ? "checked" : null)" data-feature-input>
                                        <span>@feature.Name</span>
                                    </label>
                                }

                            </div>
                        }
                        else
                        {
                            <p class="property-empty-message">Seçilebilecek özellik bulunamadı.</p>
                        }

                        <span asp-validation-for="Property.FeatureIds" class="property-validation-message"></span>

                    </div>

                </section>

            </main>

            <aside class="property-preview-column">

                <article class="property-preview-card">

                    <div class="property-preview-header">
                        <strong>Canlı İlan Önizlemesi</strong>
                        <span class="property-live-badge">Canlı</span>
                    </div>

                    <div class="property-preview-image">
                        <img src="@Url.Content("~/Mulkora_Full_Theme_With_Panels/assets/images/properties/property-01.svg")" alt="İlan önizlemesi" data-preview-image>
                        <span class="property-preview-type" data-preview-type>İlan türü</span>
                    </div>

                    <div class="property-preview-body">
                        <div class="property-preview-price" data-preview-price>₺0</div>
                        <h3 class="property-preview-title" data-preview-title>İlan başlığı</h3>

                        <div class="property-preview-location">
                            <svg class="property-svg" width="13" height="13" viewBox="0 0 24 24">
                                <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/>
                                <circle cx="12" cy="10" r="2.5"/>
                            </svg>
                            <span data-preview-location>Konum bilgisi</span>
                        </div>

                        <div class="property-preview-stats">
                            <div class="property-preview-stat">
                                <strong data-preview-room>0</strong>
                                <span>Oda</span>
                            </div>

                            <div class="property-preview-stat">
                                <strong data-preview-gross>0</strong>
                                <span>Brüt m²</span>
                            </div>

                            <div class="property-preview-stat">
                                <strong data-preview-bathroom>0</strong>
                                <span>Banyo</span>
                            </div>
                        </div>

                        <div class="property-preview-feature-count" data-preview-feature-count>0 ilan özelliği seçildi</div>
                    </div>

                </article>

                <article class="property-progress-card">
                    <h3>İlan Hazırlığı</h3>
                    <p>Tamamlanan alanlara göre ilan hazırlık durumu.</p>

                    <div class="property-progress-track">
                        <div class="property-progress-fill" data-progress-fill></div>
                    </div>

                    <div class="property-check-list">
                        <div class="property-check-item" data-check="basic"><span class="property-check-icon">✓</span>Temel bilgiler</div>
                        <div class="property-check-item" data-check="location"><span class="property-check-icon">✓</span>Konum bilgileri</div>
                        <div class="property-check-item" data-check="details"><span class="property-check-icon">✓</span>Mülk detayları</div>
                        <div class="property-check-item" data-check="images"><span class="property-check-icon">✓</span>İlan görselleri</div>
                        <div class="property-check-item" data-check="features"><span class="property-check-icon">✓</span>İlan özellikleri</div>
                    </div>
                </article>

            </aside>

        </div>

        <footer class="property-form-footer">
            <span class="property-footer-note">İlanınız ilk olarak taslak durumunda oluşturulacaktır.</span>

            <div class="property-footer-actions">
                <a asp-area="Agent" asp-controller="Property" asp-action="PropertyList" class="property-button property-button-secondary">Vazgeç</a>

                <button type="submit" class="property-button property-button-primary">
                    <svg class="property-svg" width="15" height="15" viewBox="0 0 24 24">
                        <path d="M5 12.5 9.5 17 19 7.5"/>
                    </svg>
                    İlanı Kaydet
                </button>
            </div>
        </footer>

    </form>

</div>

<script src="~/js/property-editor.js" asp-append-version="true" defer></script>