@model List<Mulkora.Dto.PropertyDtos.ResultPropertyDto>

@{
    Layout = "_AgentLayout";
    ViewData["Title"] = "İlan Yönetimi";

    var filterText = Context.Request.Query["text"].ToString();
    var filterStatus = Context.Request.Query["IsStatus"].ToString();

    var currentPage = Model.FirstOrDefault()?.CurrentPage ?? 1;
    var totalPages = Model.FirstOrDefault()?.TotalPages ?? 1;

    var startPage = Math.Max(1, currentPage - 2);
    var endPage = Math.Min(totalPages, currentPage + 2);

    var fallbackImage = Url.Content(
        "~/Mulkora_Full_Theme_With_Panels/assets/images/properties/property-01.svg"
    );
}

<link rel="stylesheet"
      href="~/css/agent/propertylist.css"
      asp-append-version="true">

<div class="property-list-page">

    <header class="property-page-heading">
        <div>
            <span class="property-page-eyebrow">
                PORTFÖY YÖNETİMİ
            </span>

            <h1>İlan Yönetimi</h1>

            <p>
                İlanlarınızı görüntüleyin, düzenleyin ve yayın
                süreçlerini yönetin.
            </p>
        </div>

        <a asp-area="Agent"
           asp-controller="Property"
           asp-action="Create"
           class="property-create-button">

            <svg class="icon"
                 width="17"
                 height="17"
                 viewBox="0 0 24 24">
                <path d="M12 5v14M5 12h14"></path>
            </svg>

            Yeni ilan ekle
        </a>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="property-alert property-alert-success">
            <svg class="icon"
                 width="19"
                 height="19"
                 viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="9"></circle>
                <path d="m8 12 2.5 2.5L16 9"></path>
            </svg>

            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="property-alert property-alert-error">
            <svg class="icon"
                 width="19"
                 height="19"
                 viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M12 7v6M12 17h.01"></path>
            </svg>

            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <section class="property-list-panel">

        <div class="property-list-toolbar">

            <form asp-area="Agent"
                  asp-controller="Property"
                  asp-action="PropertyList"
                  method="get"
                  class="property-filter-form">

                <label class="property-filter-search">
                    <svg class="icon"
                         width="17"
                         height="17"
                         viewBox="0 0 24 24">
                        <path d="M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14Zm5-2 4 4"></path>
                    </svg>

                    <input type="search"
                           name="text"
                           value="@filterText"
                           placeholder="İlan adı veya konum ara">
                </label>

                <select name="IsStatus"
                        class="property-filter-status">

                    <option value="">
                        Tüm durumlar
                    </option>

                    <option value="1"
                            selected="@(filterStatus == "1" ? "selected" : null)">
                        Taslak
                    </option>

                    <option value="2"
                            selected="@(filterStatus == "2" ? "selected" : null)">
                        Onay bekliyor
                    </option>

                    <option value="3"
                            selected="@(filterStatus == "3" ? "selected" : null)">
                        Yayında
                    </option>

                    <option value="4"
                            selected="@(filterStatus == "4" ? "selected" : null)">
                        Reddedildi
                    </option>

                    <option value="5"
                            selected="@(filterStatus == "5" ? "selected" : null)">
                        Pasif
                    </option>

                    <option value="6"
                            selected="@(filterStatus == "6" ? "selected" : null)">
                        Satıldı
                    </option>

                    <option value="7"
                            selected="@(filterStatus == "7" ? "selected" : null)">
                        Kiralandı
                    </option>
                </select>

                <button type="submit"
                        class="property-filter-button">

                    <svg class="icon"
                         width="16"
                         height="16"
                         viewBox="0 0 24 24">
                        <path d="M4 5h16M7 12h10M10 19h4"></path>
                    </svg>

                    Filtrele
                </button>

                @if (!string.IsNullOrWhiteSpace(filterText) ||
                     !string.IsNullOrWhiteSpace(filterStatus))
                {
                    <a asp-area="Agent"
                       asp-controller="Property"
                       asp-action="PropertyList"
                       class="property-clear-button">
                        Temizle
                    </a>
                }

            </form>

        </div>

        <div class="property-list-information">
            <div>
                <strong>İlan listesi</strong>

                <span>
                    Bu sayfada @Model.Count ilan gösteriliyor
                </span>
            </div>

            @if (totalPages > 1)
            {
                <span class="property-list-page-status">
                    Sayfa @currentPage / @totalPages
                </span>
            }
        </div>

        <div class="property-table-wrap">

            <table class="property-table">

                <thead>
                <tr>
                    <th>İlan</th>
                    <th>Fiyat</th>
                    <th>Durum</th>
                    <th>Tarih</th>
                    <th class="property-actions-heading">İşlemler</th>
                </tr>
                </thead>

                <tbody>

                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6"
                            class="property-empty">

                            <div class="property-empty-icon">
                                <svg class="icon"
                                     width="27"
                                     height="27"
                                     viewBox="0 0 24 24">
                                    <path d="M3 10.5 12 3l9 7.5V21H3V10.5ZM9 21v-6h6v6"></path>
                                </svg>
                            </div>

                            <strong>İlan bulunamadı</strong>

                            <span>
                                Arama kriterlerinizi değiştirerek
                                tekrar deneyebilirsiniz.
                            </span>

                            <a asp-area="Agent"
                               asp-controller="Property"
                               asp-action="PropertyList">
                                Filtreleri temizle
                            </a>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        var statusValue =
                            Convert.ToInt32(item.Status);

                        var listingTypeValue =
                            Convert.ToInt32(item.ListingType);

                        var imageUrl = fallbackImage;

                        if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            imageUrl = item.ImageUrl.StartsWith(
                                "http",
                                StringComparison.OrdinalIgnoreCase
                            )
                                ? item.ImageUrl
                                : $"http://localhost:5214/{item.ImageUrl.TrimStart('/')}";
                        }

                        <tr data-property-row>

                            <td>
                                <div class="table-property">

                                    <img src="@imageUrl"
                                         alt="@item.Title"
                                         loading="lazy"
                                         onerror="this.onerror=null;this.src='@fallbackImage';">

                                    <div>
                                        <strong>@item.Title</strong>

                                        <span>
                                            @item.District, @item.City
                                        </span>

                                        <small>
                                            İlan No: MLK-@item.PropertyId
                                        </small>
                                    </div>

                                </div>
                            </td>

                            <td>
                                <div class="property-price">
                                    <strong>
                                        ₺@item.Price.ToString("N0")
                                    </strong>

                                    <span>
                                        @(listingTypeValue == 1
                                            ? "Satılık"
                                            : "Kiralık")
                                    </span>
                                </div>
                            </td>

                            <td>
                                @if (statusValue == 1)
                                {
                                    <span class="property-status property-status-draft">
                                        <i></i>
                                        Taslak
                                    </span>
                                }
                                else if (statusValue == 2)
                                {
                                    <span class="property-status property-status-pending">
                                        <i></i>
                                        Onay Bekliyor
                                    </span>
                                }
                                else if (statusValue == 3)
                                {
                                    <span class="property-status property-status-published">
                                        <i></i>
                                        Yayında
                                    </span>
                                }
                                else if (statusValue == 4)
                                {
                                    <span class="property-status property-status-rejected">
                                        <i></i>
                                        Reddedildi
                                    </span>
                                }
                                else if (statusValue == 5)
                                {
                                    <span class="property-status property-status-passive">
                                        <i></i>
                                        Pasif
                                    </span>
                                }
                                else if (statusValue == 6)
                                {
                                    <span class="property-status property-status-sold">
                                        <i></i>
                                        Satıldı
                                    </span>
                                }
                                else if (statusValue == 7)
                                {
                                    <span class="property-status property-status-rented">
                                        <i></i>
                                        Kiralandı
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="property-date">

                                    <div class="property-date-item">
                                        <span class="property-date-dot"></span>

                                        <span class="property-date-label">
                                            Eklendi
                                        </span>

                                        <span class="property-date-value">
                                            @item.CreatedDate.ToString("dd MMM yyyy")
                                        </span>
                                    </div>

                                    @if (item.UpdatedDate.HasValue)
                                    {
                                        <div class="property-date-item">
                                            <span class="property-date-dot updated"></span>

                                            <span class="property-date-label">
                                                Güncellendi
                                            </span>

                                            <span class="property-date-value property-date-updated">
                                                @item.UpdatedDate.Value.ToString("dd MMM yyyy")
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="property-date-empty">
                                            Henüz güncellenmedi
                                        </span>
                                    }

                                </div>
                            </td>

                            <td>
                                <div class="property-table-actions">

                                    @* Taslak veya reddedilen ilan. *@
                                    @if (statusValue == 1 ||
                                         statusValue == 4)
                                    {
                                        <form asp-area="Agent"
                                              asp-controller="Property"
                                              asp-action="SendForApproval"
                                              asp-route-id="@item.PropertyId"
                                              method="post"
                                              class="property-action-form">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="property-state-button property-state-approval"
                                                    title="Onaya gönder"
                                                    onclick="return confirm('İlanı onaya göndermek istediğinize emin misiniz?')">

                                                <svg class="icon"
                                                     width="15"
                                                     height="15"
                                                     viewBox="0 0 24 24">
                                                    <path d="m3 11 18-8-8 18-2-8-8-2Z"></path>
                                                    <path d="m11 13 4-4"></path>
                                                </svg>

                                                Onaya gönder
                                            </button>
                                        </form>
                                    }

                                    @* Yayındaki satılık ilan. *@
                                    @if (statusValue == 3 &&
                                         listingTypeValue == 1)
                                    {
                                        <form asp-area="Agent"
                                              asp-controller="Property"
                                              asp-action="MarkAsSold"
                                              asp-route-id="@item.PropertyId"
                                              method="post"
                                              class="property-action-form">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="property-state-button property-state-sold"
                                                    title="Satıldı olarak işaretle"
                                                    onclick="return confirm('Bu ilanı satıldı olarak işaretlemek istediğinize emin misiniz?')">

                                                <svg class="icon"
                                                     width="15"
                                                     height="15"
                                                     viewBox="0 0 24 24">
                                                    <circle cx="12"
                                                            cy="12"
                                                            r="9"></circle>
                                                    <path d="m8 12 2.5 2.5L16 9"></path>
                                                </svg>

                                                Satıldı
                                            </button>
                                        </form>
                                    }

                                    @* Yayındaki kiralık ilan. *@
                                    @if (statusValue == 3 &&
                                         listingTypeValue == 2)
                                    {
                                        <form asp-area="Agent"
                                              asp-controller="Property"
                                              asp-action="MarkAsRented"
                                              asp-route-id="@item.PropertyId"
                                              method="post"
                                              class="property-action-form">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="property-state-button property-state-rented"
                                                    title="Kiralandı olarak işaretle"
                                                    onclick="return confirm('Bu ilanı kiralandı olarak işaretlemek istediğinize emin misiniz?')">

                                                <svg class="icon"
                                                     width="15"
                                                     height="15"
                                                     viewBox="0 0 24 24">
                                                    <path d="M4 12h9"></path>
                                                    <path d="M9 7a5 5 0 1 1 0 10"></path>
                                                    <path d="m16 12 2 2 4-4"></path>
                                                </svg>

                                                Kiralandı
                                            </button>
                                        </form>
                                    }

                                    <a asp-area="Agent"
                                       asp-controller="Property"
                                       asp-action="Update"
                                       asp-route-id="@item.PropertyId"
                                       class="property-icon-button property-icon-edit"
                                       title="Düzenle">

                                        <svg class="icon"
                                             width="15"
                                             height="15"
                                             viewBox="0 0 24 24">
                                            <path d="m4 20 4.5-1L19 8.5 15.5 5 5 15.5 4 20Z"></path>
                                            <path d="m13.5 7 3.5 3.5"></path>
                                        </svg>
                                    </a>

                                    <form asp-area="Agent"
                                          asp-controller="Property"
                                          asp-action="Deletes"
                                          asp-route-id="@item.PropertyId"
                                          method="post"
                                          class="property-action-form">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="property-icon-button property-icon-delete"
                                                title="Sil"
                                                onclick="return confirm('Bu ilanı silmek istediğinize emin misiniz?')">

                                            <svg class="icon"
                                                 width="15"
                                                 height="15"
                                                 viewBox="0 0 24 24">
                                                <path d="M3 6h18"></path>
                                                <path d="M8 6V4h8v2"></path>
                                                <path d="m19 6-1 14H6L5 6"></path>
                                                <path d="M10 10v6M14 10v6"></path>
                                            </svg>
                                        </button>
                                    </form>

                                </div>
                            </td>

                        </tr>
                    }
                }

                </tbody>

            </table>

        </div>

        @if (totalPages > 1)
        {
            <div class="property-pagination">

                <span class="property-pagination-info">
                    Sayfa @currentPage / @totalPages
                </span>

                <div class="property-pagination-list">

                    @if (currentPage > 1)
                    {
                        <a asp-area="Agent"
                           asp-controller="Property"
                           asp-action="PropertyList"
                           asp-route-text="@filterText"
                           asp-route-IsStatus="@filterStatus"
                           asp-route-page="@(currentPage - 1)"
                           class="property-page-link">
                            ‹
                        </a>
                    }
                    else
                    {
                        <span class="property-page-link disabled">
                            ‹
                        </span>
                    }

                    @if (startPage > 1)
                    {
                        <a asp-area="Agent"
                           asp-controller="Property"
                           asp-action="PropertyList"
                           asp-route-text="@filterText"
                           asp-route-IsStatus="@filterStatus"
                           asp-route-page="1"
                           class="property-page-link">
                            1
                        </a>

                        @if (startPage > 2)
                        {
                            <span class="property-page-dots">
                                ...
                            </span>
                        }
                    }

                    @for (var pageNumber = startPage;
                          pageNumber <= endPage;
                          pageNumber++)
                    {
                        <a asp-area="Agent"
                           asp-controller="Property"
                           asp-action="PropertyList"
                           asp-route-text="@filterText"
                           asp-route-IsStatus="@filterStatus"
                           asp-route-page="@pageNumber"
                           class="property-page-link @(pageNumber == currentPage ? "active" : "")">

                            @pageNumber
                        </a>
                    }

                    @if (endPage < totalPages)
                    {
                        @if (endPage < totalPages - 1)
                        {
                            <span class="property-page-dots">
                                ...
                            </span>
                        }

                        <a asp-area="Agent"
                           asp-controller="Property"
                           asp-action="PropertyList"
                           asp-route-text="@filterText"
                           asp-route-IsStatus="@filterStatus"
                           asp-route-page="@totalPages"
                           class="property-page-link">

                            @totalPages
                        </a>
                    }

                    @if (currentPage < totalPages)
                    {
                        <a asp-area="Agent"
                           asp-controller="Property"
                           asp-action="PropertyList"
                           asp-route-text="@filterText"
                           asp-route-IsStatus="@filterStatus"
                           asp-route-page="@(currentPage + 1)"
                           class="property-page-link">
                            ›
                        </a>
                    }
                    else
                    {
                        <span class="property-page-link disabled">
                            ›
                        </span>
                    }

                </div>
            </div>
        }

    </section>

</div>