@model Mulkora.Dto.PropertyDtos.UpdatePropertyDto

@{
    Layout = "_AgentLayout";
    ViewData["Title"] = "İlan Güncelle";
}

<style>
    .property-update-page {
        max-width: 1180px;
        margin: 0 auto;
        padding: 30px;
    }

    .property-update-header {
        margin-bottom: 24px;
    }

    .property-update-header h1 {
        margin: 0;
        color: #17201d;
        font-size: 28px;
        font-weight: 700;
        letter-spacing: -.03em;
    }

    .property-update-header p {
        margin: 7px 0 0;
        color: #7c8984;
        font-size: 14px;
    }

    .property-form {
        display: grid;
        gap: 20px;
    }

    .property-card {
        padding: 25px;
        background: #fff;
        border: 1px solid #e4e9e7;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(20, 35, 30, .03);
    }

    .property-card-header {
        margin-bottom: 22px;
        padding-bottom: 16px;
        border-bottom: 1px solid #edf0ef;
    }

    .property-card-header h2 {
        margin: 0;
        color: #17201d;
        font-size: 17px;
        font-weight: 700;
    }

    .property-card-header p {
        margin: 5px 0 0;
        color: #89938f;
        font-size: 13px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .form-grid-3 {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .form-group.full {
        grid-column: 1 / -1;
    }

    .form-group label {
        color: #44504c;
        font-size: 13px;
        font-weight: 600;
    }

    .form-control {
        width: 100%;
        height: 46px;
        padding: 0 13px;
        border: 1px solid #dfe5e2;
        border-radius: 9px;
        background: #fff;
        color: #17201d;
        font-size: 14px;
        outline: none;
        transition: .2s;
        box-sizing: border-box;
    }

    textarea.form-control {
        height: 130px;
        padding: 13px;
        resize: vertical;
        line-height: 1.5;
    }

    .form-control:focus {
        border-color: #173a31;
        box-shadow: 0 0 0 3px rgba(23, 58, 49, .08);
    }

    .validation-message {
        color: #c84b4b;
        font-size: 12px;
    }

    .check-box-wrapper {
        height: 46px;
        padding: 0 14px;
        display: flex;
        align-items: center;
        gap: 10px;
        border: 1px solid #dfe5e2;
        border-radius: 9px;
        background: #fafbfb;
    }

    .check-box-wrapper input {
        width: 17px;
        height: 17px;
        accent-color: #173a31;
    }

    .check-box-wrapper label {
        margin: 0;
        cursor: pointer;
    }

    .form-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
    }

    .property-btn {
        height: 43px;
        padding: 0 19px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: .2s;
    }

    .property-btn-secondary {
        border: 1px solid #dde3e0;
        background: #fff;
        color: #59645f;
    }

    .property-btn-secondary:hover {
        background: #f5f7f6;
        color: #17201d;
    }

    .property-btn-primary {
        border: 1px solid #173a31;
        background: #173a31;
        color: #fff;
    }

    .property-btn-primary:hover {
        background: #204c40;
    }

    .validation-summary-errors {
        padding: 13px 16px;
        border: 1px solid #f3c8c8;
        border-radius: 9px;
        background: #fff5f5;
        color: #b43f3f;
        font-size: 13px;
    }

    @@media (max-width: 850px) {
        .property-update-page {
            padding: 20px;
        }

        .form-grid,
        .form-grid-3 {
            grid-template-columns: 1fr;
        }

        .form-group.full {
            grid-column: auto;
        }

        .form-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .property-btn {
            width: 100%;
        }
    }
</style>

<div class="property-update-page">

    <div class="property-update-header">
        <h1>İlan Güncelle</h1>
        <p>İlan bilgilerini düzenleyerek değişiklikleri kaydedin.</p>
    </div>

    <form asp-action="Update" method="post" class="property-form">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="PropertyId" />
        <input type="hidden" asp-for="AgentId" />

        <div asp-validation-summary="ModelOnly"></div>

        <section class="property-card">

            <div class="property-card-header">
                <h2>Temel Bilgiler</h2>
                <p>İlanın temel bilgilerini düzenleyin.</p>
            </div>

            <div class="form-grid">

                <div class="form-group full">
                    <label asp-for="Title">İlan Başlığı</label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="validation-message"></span>
                </div>

                <div class="form-group full">
                    <label asp-for="Description">Açıklama</label>
                    <textarea asp-for="Description" class="form-control"></textarea>
                    <span asp-validation-for="Description" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Price">Fiyat</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="Price" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ListingType">İlan Türü</label>
                    <select asp-for="ListingType" class="form-control">
                        <option value="1">Satılık</option>
                        <option value="2">Kiralık</option>
                    </select>
                    <span asp-validation-for="ListingType" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="CategoryId">Kategori</label>
                    <input asp-for="CategoryId" type="number" class="form-control" />
                    <span asp-validation-for="CategoryId" class="validation-message"></span>
                </div>

            </div>

        </section>

        <section class="property-card">

            <div class="property-card-header">
                <h2>Konum Bilgileri</h2>
                <p>İlanın şehir, ilçe ve adres bilgilerini düzenleyin.</p>
            </div>

            <div class="form-grid">

                <div class="form-group">
                    <label asp-for="City">Şehir</label>
                    <input asp-for="City" class="form-control" />
                    <span asp-validation-for="City" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="District">İlçe</label>
                    <input asp-for="District" class="form-control" />
                    <span asp-validation-for="District" class="validation-message"></span>
                </div>

                <div class="form-group full">
                    <label asp-for="Address">Açık Adres</label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="validation-message"></span>
                </div>

            </div>

        </section>

        <section class="property-card">

            <div class="property-card-header">
                <h2>Oda Bilgileri</h2>
                <p>Oda, salon ve banyo sayılarını düzenleyin.</p>
            </div>

            <div class="form-grid form-grid-3">

                <div class="form-group">
                    <label asp-for="RoomCount">Oda Sayısı</label>
                    <input asp-for="RoomCount" type="number" min="0" class="form-control" />
                    <span asp-validation-for="RoomCount" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="LivingRoomCount">Salon Sayısı</label>
                    <input asp-for="LivingRoomCount" type="number" min="0" class="form-control" />
                    <span asp-validation-for="LivingRoomCount" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="BathroomCount">Banyo Sayısı</label>
                    <input asp-for="BathroomCount" type="number" min="0" class="form-control" />
                    <span asp-validation-for="BathroomCount" class="validation-message"></span>
                </div>

            </div>

        </section>

        <section class="property-card">

            <div class="property-card-header">
                <h2>Alan ve Bina Bilgileri</h2>
                <p>Metrekare, bina yaşı ve kat bilgilerini düzenleyin.</p>
            </div>

            <div class="form-grid form-grid-3">

                <div class="form-group">
                    <label asp-for="GrossSquareMeter">Brüt m²</label>
                    <input asp-for="GrossSquareMeter" type="number" min="0" class="form-control" />
                    <span asp-validation-for="GrossSquareMeter" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="NetSquareMeter">Net m²</label>
                    <input asp-for="NetSquareMeter" type="number" min="0" class="form-control" />
                    <span asp-validation-for="NetSquareMeter" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="BuildingAge">Bina Yaşı</label>
                    <input asp-for="BuildingAge" type="number" min="0" class="form-control" />
                    <span asp-validation-for="BuildingAge" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="FloorNumber">Bulunduğu Kat</label>
                    <input asp-for="FloorNumber" type="number" class="form-control" />
                    <span asp-validation-for="FloorNumber" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="TotalFloor">Toplam Kat</label>
                    <input asp-for="TotalFloor" type="number" min="1" class="form-control" />
                    <span asp-validation-for="TotalFloor" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label>Eşya Durumu</label>

                    <div class="check-box-wrapper">
                        <input asp-for="IsFurnished" />
                        <label asp-for="IsFurnished">Eşyalı</label>
                    </div>
                </div>

            </div>

        </section>

        <div class="form-actions">

            <a asp-action="PropertyList" class="property-btn property-btn-secondary">
                Vazgeç
            </a>

            <button type="submit" class="property-btn property-btn-primary">
                Değişiklikleri Kaydet
            </button>

        </div>

    </form>

</div>